@prefix topic: <http://mee.foundation/ontologies/topic#> .
@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/topic> .

<http://mee.foundation/ontologies/topic> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/topic/1.16.0> ;
    dc:date "2026-08-21"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/cell> ;
    rdfs:label "Topic Ontology"@en ;
    rdfs:comment """Topic Ontology for the Mee Identity Agent"""@en .


#################################################################
#    Annotation Properties for Topic DataBook Classification
#################################################################

topic:claimant rdf:type owl:AnnotationProperty ;
    rdfs:label "claimed by"@en ;
    rdfs:comment """Annotates a topic DataBook with the identity making the claim —
                    a named individual of p:Person or o:Organization (e.g. :Self,
                    a p:Person or o:Organization instance). Applied to the topic
                    DataBook's own IRI (its plain `id`) — the same IRI
                    cell:memberTopics/cell:otherTopics link to from the cell side —
                    not to the `#graph`-suffixed `graph.named_graph` IRI, and not
                    to the Person individual."""@en ;
    rdfs:domain topic:SCTopicGraph ;
    rdfs:range [ rdf:type owl:Class ; owl:unionOf ( p:Person o:Organization ) ] .

topic:subject rdf:type owl:AnnotationProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment """Annotates a topic DataBook with the resource it is about. Value
                    may be any resource IRI — a topic need not be about a person's
                    identity. In the example data, every subject value happens to be a
                    named individual of p:Person or o:Organization (e.g.
                    :Self, a p:Person or o:Organization instance), but that is
                    a convention of the example data, not an ontology requirement.
                    Applied to the topic DataBook's own IRI (its plain `id`) — the same
                    IRI cell:memberTopics/cell:otherTopics link to from the cell
                    side — not to the `#graph`-suffixed `graph.named_graph` IRI,
                    and not to the subject resource itself."""@en ;
    rdfs:domain topic:SCTopicGraph ;
    rdfs:range xsd:anyURI .

topic:template rdf:type owl:AnnotationProperty ;
    rdfs:label "template"@en ;
    rdfs:comment """Annotates a topic DataBook with the persona template type that applies to it.
                    Value is one of the persona:PersonaTemplate subclasses (persona:BirthCertificateDocument,
                    persona:JSContactCard, persona:DriversLicenseDocument, persona:PassportDocument,
                    persona:MedicalAppointmentRecord).
                    Used to select the appropriate per-template SHACL shapes file for validation.
                    Applied to the topic DataBook's own IRI (its plain `id`), not the
                    `#graph`-suffixed `graph.named_graph` IRI — matching topic:subject and
                    topic:claimant."""@en ;
    rdfs:domain topic:TopicGraph ;
    rdfs:range <http://mee.foundation/ontologies/persona#PersonaTemplate> .


#################################################################
#    TopicGraph (DataBook) and SCTopicGraph
#################################################################

topic:TopicGraph rdf:type owl:Class ;
    cell:abstract true ;
    rdfs:label "TopicGraph"@en ;
    rdfs:comment "A topic DataBook — a named graph of claims about some resource, filed in a specific relationship or situation, extracted into a named graph (graph.named_graph, the DataBook's own `id` plus a `#graph` fragment) — since this class's instances represent exactly the content that becomes that named graph, see the 'Topic Graph' DataBook section heading convention. The resource it is about need not be a person's identity — see topic:subject. Instances of this class and its annotations (topic:subject, topic:claimant, topic:template) are typed and asserted on the DataBook's own `id` IRI, not the `#graph`-suffixed named graph IRI that wraps its extracted content."@en .

topic:SCTopicGraph rdf:type owl:Class ;
    rdfs:subClassOf topic:TopicGraph ;
    rdfs:label "SCTopicGraph"@en ;
    rdfs:comment "Subject-Claimant topic graph: the concrete class every self-vs-other classified topic DataBook is typed as directly — it has no subclasses; the four self-vs-other cases (self-by-self, other-by-self, other-by-other, self-by-other) are determined directly from the combination of subject and claimant. Carries the subject and claimant annotations — every topic reachable from a cell, via cell:memberTopics/cell:otherTopics, is a topic:SCTopicGraph and so always carries them."@en .
