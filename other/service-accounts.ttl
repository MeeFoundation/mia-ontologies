@prefix serviceaccounts: <http://mee.foundation/ontologies/service-accounts#> .
@prefix persona: <http://mee.foundation/ontologies/persona#> .
@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/service-accounts> .

<http://mee.foundation/ontologies/service-accounts> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/service-accounts/1.0.0> ;
    dc:date "2026-09-05"^^xsd:date ;
    owl:versionInfo "Version 1.0.0 - initial extraction of serviceaccounts:ServiceAccount out of persona-extensions.ttl, and persona:hasPassword out of persona.ttl, into their own other/ peer ontology."@en ;
    rdfs:label "Service Accounts Ontology"@en ;
    rdfs:comment """A small other/ peer ontology (see other/pets.ttl's own rdfs:comment for the
                    general pattern) for a domain a person merely *has* — an online service account
                    (e.g. with Google or AT&T) — rather than *is*, kept out of persona.ttl the same way
                    pet/vehicle/identity-document domain-modeling already are. persona.ttl carries no
                    thin hasX-link property of its own pointing at serviceaccounts:ServiceAccount — CCO's
                    own "holds user account" (cco:ent00000045, already documented via persona.ttl's
                    p:usesCCOProperty) already plays that role, so no new persona-defined link is needed.

                    serviceaccounts:ServiceAccount is an independent template type label class, asserted
                    via rdf:type directly on the graph's own content individual and targeted directly by
                    its own SHACL shape (other/shacl/service-accounts-shacl.ttl) — independent of
                    cell.ttl's cell:template property, whose own range is sh:NodeShape (the validating
                    shape, not the content's own class). serviceaccounts:hasPassword is domain cco:ent00000033 (Online Service Account, StagingOntology), the
                    very class serviceaccounts:ServiceAccount is always multi-typed alongside — internal
                    plumbing of this one domain, not a general persona:Person property, so it belongs
                    here rather than in persona.ttl."""@en .


#################################################################
#    ServiceAccount
#################################################################

serviceaccounts:ServiceAccount rdf:type owl:Class ;
    rdfs:label "Service Account"@en ;
    rdfs:comment """Label for a graph whose purpose is to carry the login
                    credentials for one of a person's online service accounts (e.g. a Google
                    account, a company's web portal). The individual carrying this type is
                    always also typed cco:ent00000033 (Online Service Account, StagingOntology)
                    — the two types combine on one individual, the same multi-typing pattern
                    persona:Person/p:ContactInfo already use — so its service name, username,
                    and service URI use cco:ent00000033's own existing properties directly
                    (cco:ent00000034 has service name, cco:ent00000035 has user handle,
                    cco:ent00000036 has service URI), with no domain change to any of them;
                    only the password credential (serviceaccounts:hasPassword) is a
                    ServiceAccount-native property. Asserted via rdf:type directly on the graph
                    file's own individual, validated by the SHACL shape :ServiceAccountShape in
                    other/shacl/service-accounts-shacl.ttl, linked from cat:Companies's and
                    cat:BankingPayments's own class-level cells (cat-templates.ttl) via
                    cell:topicGraphShape. Not an identitydocuments:IdentityDocument — a service
                    account credential is not a government-issued identity document."""@en .

serviceaccounts:hasPassword rdf:type owl:DatatypeProperty ;
    rdfs:domain cco:ent00000033 ;  # Online Service Account
    rdfs:range xsd:string ;
    rdfs:label "has password"@en ;
    rdfs:comment "The password credential for an online service account."@en .
