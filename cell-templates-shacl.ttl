@prefix : <http://mee.foundation/ontologies/persona/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix persona: <http://mee.foundation/ontologies/persona#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

#################################################################
#  BirthCertificate
#################################################################

<http://mee.foundation/ontologies/persona/shapes/birthcertificate> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/birthcertificate/1.0.7> ;
    dc:date "2026-08-23"^^xsd:date ;
    rdfs:label "Birth Certificate Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying cell:template persona:BirthCertificateDocument.
                    Apply in addition to persona-shacl.ttl when validating a birth certificate graph file.
                    Targets persona:BirthCertificateDocument document individuals directly — identity claims
                    (names, designators) are properties of the document, not the Person."""@en .


#################################################################
#  Birth Certificate Document Shape
#  Targets persona:BirthCertificateDocument individuals.
#  All identity claims are properties of the document individual.
#  Required: FullName (1..1) OR (GivenName (1..1) AND FamilyName (1..1))
#  Optional: AdditionalName (ent00000003), AlternateName (ent00000006),
#            Nickname, Legal Name
#################################################################

:BirthCertificateDocumentShape
    a sh:NodeShape ;
    sh:targetClass persona:BirthCertificateDocument ;
    sh:message "Birth certificate document must record either FullName OR (GivenName + FamilyName)."@en ;

    # Name requirement: EITHER FullName OR (GivenName AND FamilyName)
    sh:or (
        [
            sh:property [
                sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;  # designated by
                sh:qualifiedValueShape [ sh:class cco:ent00000001 ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "Birth certificate must record at least one FullName, OR provide GivenName + FamilyName."@en
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;  # designated by
                        sh:qualifiedValueShape [ sh:class cco:ent00000002 ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "If no FullName is recorded, birth certificate must include at least one GivenName."@en
                    ]
                ]
                [
                    sh:property [
                        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;  # designated by
                        sh:qualifiedValueShape [ sh:class cco:ent00000004 ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "If no FullName is recorded, birth certificate must include at least one FamilyName."@en
                    ]
                ]
            )
        ]
    ) ;

    # Optional name components
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;  # designated by
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class cco:ent00000003 ]
                [ sh:class cco:ent00000005 ]
                [ sh:class cco:ent00000006 ]
                [ sh:class <https://w3id.org/cco-domains/cco/ont00000990> ]  # Nickname
                [ sh:class <https://w3id.org/cco-domains/cco/ont00001331> ]  # Legal Name
            )
        ] ;
        sh:qualifiedMaxCount 50 ;
        sh:message "Optional name designators are allowed (up to 50 total across these types)."@en
    ] .


#################################################################
#  DriversLicense
#################################################################

<http://mee.foundation/ontologies/persona/shapes/driverslicense> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/driverslicense/1.1.0> ;
    dc:date "2026-08-23"^^xsd:date ;
    rdfs:label "Driver's License Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying cell:template persona:DriversLicenseDocument.
                    Apply in addition to persona-shacl.ttl when validating a driver's license graph file.
                    Targets persona:DriversLicenseDocument document individuals directly — identity claims
                    (names, dates, license number) are properties of the document, not the Person."""@en .


#################################################################
#  DriversLicense Document Shape
#  Targets persona:DriversLicenseDocument individuals.
#  All identity claims are properties of the document individual.
#  Required: FullName (1..1) OR (GivenName (1..1) AND FamilyName (1..1))
#            DateOfBirth (ent00000046, 1..1)
#            DriversLicenseNumber (cco:ent00000065, 1..1)
#            ExpirationDate (has expiration date cco:ent00000070 → Calendar Date Identifier, 1..1)
#  Optional: AdditionalName (ent00000003, 0..1), PostalAddress (ent00000010, 0..1)
#            IssuingJurisdiction (cco:ent00000068, 0..1)
#            Photo (persona:hasPhoto, 0..1)
#################################################################

:DriversLicenseDocumentShape
    a sh:NodeShape ;
    sh:targetClass persona:DriversLicenseDocument ;
    sh:message "Driver's license document validation: name, date of birth, license number, and expiration date are required."@en ;

    # ── Name: FullName OR (GivenName + FamilyName) ───────────────────────────
    sh:or (
        [
            sh:property [
                sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
                sh:qualifiedValueShape [ sh:class cco:ent00000001 ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "A DriversLicense must record a FullName, OR provide GivenName + FamilyName."@en
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
                        sh:qualifiedValueShape [ sh:class cco:ent00000002 ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "If no FullName is recorded, a DriversLicense must include at least one GivenName."@en
                    ]
                ]
                [
                    sh:property [
                        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
                        sh:qualifiedValueShape [ sh:class cco:ent00000004 ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "If no FullName is recorded, a DriversLicense must include at least one FamilyName."@en
                    ]
                ]
            )
        ]
    ) ;

    # ── Required: DateOfBirth, LicenseNumber, ExpirationDate ─────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000046 ] ;  # Birthdate
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A DriversLicense must record exactly one DateOfBirth."@en
    ] ;

    sh:property [
        # Two-relation form: the document is-carrier-of the number node (Person is designated-by it).
        sh:path <http://purl.obolibrary.org/obo/BFO_0000101> ;  # is carrier of
        sh:qualifiedValueShape [ sh:class cco:ent00000065 ] ;  # Drivers License Number
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A DriversLicense must carry exactly one DriversLicenseNumber (via is-carrier-of)."@en
    ] ;

    sh:property [
        sh:path cco:ent00000070 ;  # has expiration date → Calendar Date Identifier
        sh:qualifiedValueShape [ sh:class cco:ont00001340 ] ;  # Calendar Date Identifier
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A DriversLicense must record exactly one expiration date."@en
    ] ;

    # ── Optional fields ──────────────────────────────────────────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000003 ] ;  # AdditionalName
        sh:qualifiedMaxCount 1 ;
        sh:message "A DriversLicense may record at most one AdditionalName."@en
    ] ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000010 ] ;  # USPostalAddress
        sh:qualifiedMaxCount 1 ;
        sh:message "A DriversLicense may record at most one residential address."@en
    ] ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000068 ] ;  # Issuing Jurisdiction
        sh:qualifiedMaxCount 1 ;
        sh:message "A DriversLicense may record at most one IssuingJurisdiction."@en
    ] ;

    sh:property [
        sh:path persona:hasPhoto ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "A DriversLicense may record at most one photo."@en
    ] .


#################################################################
#  Passport
#################################################################

<http://mee.foundation/ontologies/persona/shapes/passport> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/passport/1.1.0> ;
    dc:date "2026-08-23"^^xsd:date ;
    rdfs:label "Passport Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying cell:template persona:PassportDocument.
                    Apply in addition to persona-shacl.ttl when validating a passport graph file.
                    Targets persona:PassportDocument document individuals directly — identity claims
                    (names, dates, passport number) are properties of the document, not the Person."""@en .


#################################################################
#  Passport Document Shape
#  Targets persona:PassportDocument individuals.
#  All identity claims are properties of the document individual.
#  Required: FullName (1..1) OR (GivenName (1..1) AND FamilyName (1..1))
#            DateOfBirth (ent00000046, 1..1)
#            PassportNumber (cco:ent00000066, 1..1)
#            ExpirationDate (has expiration date cco:ent00000070 → Calendar Date Identifier, 1..1)
#  Optional: AdditionalName (ent00000003, 0..1)
#            IssueDate (has issue date cco:ent00000069 → Calendar Date Identifier, 0..1)
#            IssuingCountry (cco:ent00000068 Issuing Jurisdiction, 0..1)
#            PlaceOfBirth (cco:ent00000067, 0..1)
#            GenderMarker (persona:GenderMarker, 0..1)
#            Photo (persona:hasPhoto, 0..1)
#################################################################

:PassportDocumentShape
    a sh:NodeShape ;
    sh:targetClass persona:PassportDocument ;
    sh:message "Passport document validation: name, date of birth, passport number, and expiration date are required."@en ;

    # ── Name: FullName OR (GivenName + FamilyName) ───────────────────────────
    sh:or (
        [
            sh:property [
                sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
                sh:qualifiedValueShape [ sh:class cco:ent00000001 ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "A Passport must record a FullName, OR provide GivenName + FamilyName."@en
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
                        sh:qualifiedValueShape [ sh:class cco:ent00000002 ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "If no FullName is recorded, a Passport must include at least one GivenName."@en
                    ]
                ]
                [
                    sh:property [
                        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
                        sh:qualifiedValueShape [ sh:class cco:ent00000004 ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "If no FullName is recorded, a Passport must include at least one FamilyName."@en
                    ]
                ]
            )
        ]
    ) ;

    # ── Required: DateOfBirth, PassportNumber, ExpirationDate ────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000046 ] ;  # Birthdate
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A Passport must record exactly one DateOfBirth."@en
    ] ;

    sh:property [
        # Two-relation form: the document is-carrier-of the number node (Person is designated-by it).
        sh:path <http://purl.obolibrary.org/obo/BFO_0000101> ;  # is carrier of
        sh:qualifiedValueShape [ sh:class cco:ent00000066 ] ;  # Passport Number
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A Passport must carry exactly one PassportNumber (via is-carrier-of)."@en
    ] ;

    sh:property [
        sh:path cco:ent00000070 ;  # has expiration date → Calendar Date Identifier
        sh:qualifiedValueShape [ sh:class cco:ont00001340 ] ;  # Calendar Date Identifier
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A Passport must record exactly one expiration date."@en
    ] ;

    # ── Optional fields ──────────────────────────────────────────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000003 ] ;  # AdditionalName
        sh:qualifiedMaxCount 1 ;
        sh:message "A Passport may record at most one AdditionalName."@en
    ] ;

    sh:property [
        sh:path cco:ent00000069 ;  # has issue date → Calendar Date Identifier
        sh:qualifiedValueShape [ sh:class cco:ont00001340 ] ;  # Calendar Date Identifier
        sh:qualifiedMaxCount 1 ;
        sh:message "A Passport may record at most one issue date."@en
    ] ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000068 ] ;  # Issuing Jurisdiction (collapsed from IssuingCountry)
        sh:qualifiedMaxCount 1 ;
        sh:message "A Passport may record at most one IssuingCountry."@en
    ] ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000067 ] ;  # Place of Birth
        sh:qualifiedMaxCount 1 ;
        sh:message "A Passport may record at most one PlaceOfBirth."@en
    ] ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class persona:GenderMarker ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A Passport may record at most one GenderMarker."@en
    ] ;

    sh:property [
        sh:path persona:hasPhoto ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "A Passport may record at most one photo."@en
    ] .


#################################################################
#  MedicalAppointment
#################################################################

<http://mee.foundation/ontologies/persona/shapes/medical-appointment> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/medical-appointment/1.0.5> ;
    dc:date "2026-08-23"^^xsd:date ;
    rdfs:label "Medical Appointment Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying cell:template persona:MedicalAppointmentRecord.
                    Apply in addition to persona-shacl.ttl when validating a medical appointment graph file.
                    Targets persona:MedicalAppointmentRecord individuals directly — the claims needed to arrange
                    the appointment are properties of the record, not of the patient's Person individual."""@en .


#################################################################
#  Medical Appointment Record Shape
#  Targets persona:MedicalAppointmentRecord individuals.
#  Required: forPatient (persona:forPatient, 1..1)
#            InsuranceProvider (persona:insuranceProvider, 1..1)
#            InsurancePolicyNumber (persona:insurancePolicyNumber, 1..1)
#  Optional: PrimaryCarePhysician (persona:hasPrimaryCarePhysician, 0..1)
#            CurrentMedication (persona:currentMedication, 0..n)
#            Allergy (persona:allergy, 0..n)
#            MedicalHistoryNote (persona:medicalHistoryNote, 0..1)
#            InsuranceGroupNumber (persona:insuranceGroupNumber, 0..1)
#            PreferredPharmacy (persona:preferredPharmacy, 0..1)
#################################################################

:MedicalAppointmentRecordShape
    a sh:NodeShape ;
    sh:targetClass persona:MedicalAppointmentRecord ;
    sh:message "Medical Appointment record validation: patient, insurance provider, and policy number are required."@en ;

    # ── Required: patient, insurance provider, insurance policy number ──────
    sh:property [
        sh:path persona:forPatient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class persona:Person ;
        sh:message "A Medical Appointment record must link to exactly one patient via forPatient."@en
    ] ;

    sh:property [
        sh:path persona:insuranceProvider ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Medical Appointment record must record exactly one insurance provider."@en
    ] ;

    sh:property [
        sh:path persona:insurancePolicyNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Medical Appointment record must record exactly one insurance policy number."@en
    ] ;

    # ── Optional fields ──────────────────────────────────────────────────────
    sh:property [
        sh:path persona:hasPrimaryCarePhysician ;
        sh:maxCount 1 ;
        sh:class persona:Person ;
        sh:message "A Medical Appointment record may link to at most one primary care physician."@en
    ] ;

    sh:property [
        sh:path persona:medicalHistoryNote ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Medical Appointment record may have at most one medical history note."@en
    ] ;

    sh:property [
        sh:path persona:insuranceGroupNumber ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Medical Appointment record may have at most one insurance group number."@en
    ] ;

    sh:property [
        sh:path persona:preferredPharmacy ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Medical Appointment record may have at most one preferred pharmacy."@en
    ] .
    # ── Multi-valued claims (no upper bound) ─────────────────────────────────
    # currentMedication, allergy — no sh:maxCount constraint; repeatable.


#################################################################
#  ServiceAccount
#################################################################

<http://mee.foundation/ontologies/persona/shapes/serviceaccount> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/serviceaccount/1.0.0> ;
    dc:date "2026-09-04"^^xsd:date ;
    rdfs:label "Service Account Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying cell:template persona:ServiceAccount.
                    Apply in addition to persona-shacl.ttl when validating a service account graph file.
                    Targets persona:ServiceAccount individuals directly — also typed cco:ent00000033
                    (Online Service Account), so its own existing service-name/user-handle/service-URI
                    properties are constrained here without any change to their domain."""@en .


#################################################################
#  Service Account Shape
#  Targets persona:ServiceAccount individuals (also typed cco:ent00000033).
#  Required: username (cco:ent00000035 has user handle, 1..1)
#            password (persona:hasPassword, 1..1)
#  Optional: service name (cco:ent00000034 has service name, 0..1)
#            service URI (cco:ent00000036 has service URI, 0..1)
#################################################################

:ServiceAccountShape
    a sh:NodeShape ;
    sh:targetClass persona:ServiceAccount ;
    sh:message "Service Account validation: username and password are required."@en ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ent00000035> ;  # has user handle
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A ServiceAccount must record exactly one username (user handle)."@en
    ] ;

    sh:property [
        sh:path persona:hasPassword ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A ServiceAccount must record exactly one password."@en
    ] ;

    # ── Optional fields ──────────────────────────────────────────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ent00000034> ;  # has service name
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A ServiceAccount may record at most one service name."@en
    ] ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ent00000036> ;  # has service URI
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "A ServiceAccount may record at most one service URI."@en
    ] .


#################################################################
#  Residence
#################################################################

<http://mee.foundation/ontologies/persona/shapes/residence> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/residence/1.0.0> ;
    dc:date "2026-09-04"^^xsd:date ;
    rdfs:label "Residence Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying cell:template persona:Residence.
                    Apply in addition to persona-shacl.ttl when validating a residence graph file.
                    Targets persona:Residence individuals directly — also typed cco:ent00000016
                    (AddressDesignation), so its own existing address/participant/temporal-region
                    properties are constrained here without any change to their domain."""@en .


#################################################################
#  Residence Shape
#  Targets persona:Residence individuals (also typed cco:ent00000016).
#  Required: address (AddressOntology#ent00000324 has address, 1..1)
#            occupies temporal region (BFO_0000199, 1..1)
#  Optional: has participant (BFO_0000057, 0..1) — the resident, usually :Self
#################################################################

:ResidenceShape
    a sh:NodeShape ;
    sh:targetClass persona:Residence ;
    sh:message "A Residence must have exactly one address and occupy exactly one temporal region."@en ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/domains/AddressOntology#ent00000324> ;  # has address
        sh:class cco:ent00000010 ;  # USPostalAddress
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Residence must have exactly one address."@en
    ] ;

    sh:property [
        sh:path <http://purl.obolibrary.org/obo/BFO_0000199> ;  # occupies temporal region
        sh:class <http://purl.obolibrary.org/obo/BFO_0000038> ;  # TemporalInterval
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Residence must occupy exactly one temporal region (TemporalInterval)."@en
    ] ;

    # ── Optional fields ──────────────────────────────────────────────────────
    sh:property [
        sh:path <http://purl.obolibrary.org/obo/BFO_0000057> ;  # has participant
        sh:class persona:Person ;
        sh:maxCount 1 ;
        sh:message "A Residence may have at most one participant (the resident)."@en
    ] .


#################################################################
#  Itinerary
#################################################################

<http://mee.foundation/ontologies/persona/shapes/itinerary> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/itinerary/1.0.0> ;
    dc:date "2026-09-04"^^xsd:date ;
    rdfs:label "Itinerary Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying cell:template persona:Itinerary.
                    Apply in addition to persona-shacl.ttl when validating a trip itinerary graph
                    file. Targets persona:Itinerary individuals directly — no existing CCO/domain
                    class to multi-type alongside, so this shape requires only a human-readable
                    description rather than any structured trip-planning fields."""@en .


#################################################################
#  Itinerary Shape
#  Targets persona:Itinerary individuals.
#  Required: at least one of rdfs:label or rdfs:comment (free-text description)
#################################################################

:ItineraryShape
    a sh:NodeShape ;
    sh:targetClass persona:Itinerary ;
    sh:message "An Itinerary must have at least a human-readable label or description."@en ;
    sh:or (
        [ sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rdfs:comment ; sh:minCount 1 ] ]
    ) .


#################################################################
#  Primary Care Physician
#################################################################

<http://mee.foundation/ontologies/persona/shapes/primarycarephysician> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/primarycarephysician/1.0.0> ;
    dc:date "2026-09-05"^^xsd:date ;
    rdfs:label "Primary Care Physician Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating cat:PrimaryCarePhysician's own cell:topicGraphShape.
                    Apply in addition to persona-shacl.ttl when validating a primary-care-physician
                    topic graph. Targets persona:Person directly — a physician has no reified
                    document individual of their own — with one optional property,
                    persona:specialty, matching Dr. Jane Starostina's own graph (graph-25)."""@en .

:PrimaryCarePhysicianShape
    a sh:NodeShape ;
    sh:targetClass persona:Person ;
    sh:message "Primary Care Physician topic: an optional medical specialty."@en ;
    sh:property [
        sh:path persona:specialty ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Person may record at most one specialty, as a string."@en
    ] .


# Pets shapes (cat:Pets, cat:PetsMedical) live in other/pets-shacl.ttl, not here — pets:Pet and
# pets:PetMedicationRecord/pets:Medication are declared in the peer other/pets.ttl ontology, not
