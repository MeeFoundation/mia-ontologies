@prefix : <http://mee.foundation/ontologies/graph/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix g: <http://mee.foundation/ontologies/graph#> .
@prefix persona: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix agent: <http://mee.foundation/ontologies/agent#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/graph/shapes> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/graph> ;
    owl:versionIRI <http://mee.foundation/ontologies/graph/shapes/1.6.0> ;
    dc:date "2026-08-30"^^xsd:date ;
    rdfs:label "Graph Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for graph.ttl's g:SCGraph DataBook instances."@en .


#################################################################
#  Graph DataBook (g:SCGraph)
#  Validates the subject/claimant classification fields on every
#  graph DataBook
#################################################################

:SCGraphShape
    a sh:NodeShape ;
    sh:targetClass g:SCGraph ;
    sh:message "SCGraph validation: claimant must be exactly one Person, Organization, or Agent; subject must be exactly one IRI."@en ;
    sh:property [
        sh:path g:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "g:subject must have exactly one value, and it must be an IRI."@en
    ] ;
    sh:property [
        sh:path g:claimant ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class persona:Person ] [ sh:class o:Organization ] [ sh:class agent:Agent ] ) ;
        sh:message "g:claimant must have exactly one value, and it must be a persona:Person, o:Organization, or agent:Agent."@en
    ] .
