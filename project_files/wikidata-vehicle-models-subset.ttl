@prefix : <http://mee.foundation/ontologies/wikidata-vehicle-models-subset#> .
@prefix vehicles: <http://mee.foundation/ontologies/vehicles#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://mee.foundation/ontologies/wikidata-vehicle-models-subset> .

<http://mee.foundation/ontologies/wikidata-vehicle-models-subset> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/wikidata-vehicle-models-subset/1.0.0> ;
    dc:date "2026-08-29"^^xsd:date ;
    owl:versionInfo "Version 1.0.0 - initial set of 21 current/recent flagship models (18 car, 1 motorcycle, 1 bus, 1 scooter) across the manufacturers in project_files/wikidata-vehicle-makes-subset.ttl, verified against live Wikidata."@en ;
    owl:imports <http://mee.foundation/ontologies/wikidata-vehicle-makes-subset> ;
    rdfs:label "Wikidata Vehicle Models Subset"@en ;
    rdfs:comment """A hand-curated subset of Wikidata (https://www.wikidata.org) — a small number of
                    current/recent flagship models per manufacturer vendored in
                    project_files/wikidata-vehicle-makes-subset.ttl, the piece other/vehicles.ttl's
                    vehicles:hasModel needs, analogous to project_files/vbo-subset.ttl's role for
                    pets:hasBreed. Unlike vbo-subset.ttl's real full extraction of VBO's entire pet-relevant
                    breed tree, this is NOT exhaustive — full historical model lineups across every
                    manufacturer's entire production history would run to many thousands of entries, so, like
                    the makes file it depends on, this stays a small hand-picked illustrative set (one or two
                    well-known current/recent models per make, not a full lineup), verified live against
                    https://query.wikidata.org/sparql (2026-08-29) rather than every model Wikidata records
                    for these manufacturers. Each individual reuses its real Wikidata Q-ID directly as its own
                    IRI, typed owl:NamedIndividual, vehicles:Model — the same deliberate class-vs-individual
                    adaptation documented in wikidata-vehicle-makes-subset.ttl's own header (Wikidata's own
                    "car model" class, wd:Q3231690, is instantiated by these entities, not subclassed).
                    Each individual also carries vehicles:modelMake linking it back to its manufacturer
                    individual in wikidata-vehicle-makes-subset.ttl — the cross-vendor-file link, the same
                    role project_files/vbo-subset.ttl's breed-group-node-to-NCBITaxon-species subClassOf link
                    plays for pets:hasBreed, adapted here to an object-property link between two individuals
                    rather than a class-hierarchy subClassOf assertion, since neither side is a class.
                    Wikidata's own content is released under CC0 (public domain dedication), so no
                    attribution obligation applies."""@en .

