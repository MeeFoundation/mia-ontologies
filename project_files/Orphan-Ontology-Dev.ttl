<http://www.ontologyrepository.com/CommonCoreOntologies/Domain/OrphanClassesOntology-Dev> rdf:type owl:Ontology ;
                                                                                           owl:versionIRI <http://www.ontologyrepository.com/CommonCoreOntologies/Domain/2023-10-1/OrphanClassesOntology-Dev> ;
                                                                                           owl:imports <http://www.ontologyrepository.com/CommonCoreOntologies/Mid/AllCoreOntology> ;
                                                                                           rdfs:comment "This is a temporary holding ontology for classes that will later be moved into new domain ontologies (that extend from CCO) or promoted up into CCO. They don't fit well within existing domains (e.g., Cyber Ontology or Person Ontology) so they are temporarilty held in this Orphan-Classes Ontology."@en ;
                                                                                           rdfs:label "Person Ontology"@en ;
                                                                                           owl:versionInfo "Version 2024-6-20"@en .

