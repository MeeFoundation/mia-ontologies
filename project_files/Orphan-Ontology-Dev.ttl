###  http://www.co-ode.org/ontologies/ont.owl#OWLClass_210b926a_c13c_4c29_9d96_047087f9b362
<http://www.co-ode.org/ontologies/ont.owl#OWLClass_210b926a_c13c_4c29_9d96_047087f9b362> rdf:type owl:Class ;
                                                                                         rdfs:subClassOf cco:CodeIdentifier ;
                                                                                         cco:definition "A Code Identifier that designates a credit card account." ;
                                                                                         rdfs:label "Credit Card Number"@en .


###  http://www.co-ode.org/ontologies/ont.owl#OWLClass_34f09416_31ac_451a_808b_2a8cbaee471d
<http://www.co-ode.org/ontologies/ont.owl#OWLClass_34f09416_31ac_451a_808b_2a8cbaee471d> rdf:type owl:Class ;
                                                                                         rdfs:subClassOf cco:TimeOfDayIdentifier ;
                                                                                         cco:definition "A Time of Day Identifier that designates when something is no longer valid. Can be expressed as a given day, month, or year, which means the last Temporal Instant of that Temporal Interval." ;
                                                                                         rdfs:label "Expiration Date Identifier"@en .


###  http://www.co-ode.org/ontologies/ont.owl#OWLClass_bc0a129d_5bee_447c_b8b6_611f9d5b8df7
<http://www.co-ode.org/ontologies/ont.owl#OWLClass_bc0a129d_5bee_447c_b8b6_611f9d5b8df7> rdf:type owl:Class ;
                                                                                         rdfs:subClassOf cco:CodeIdentifier ;
                                                                                         cco:definition "A Code Identifier printed on a credit card that helps reduce online fraud." ;
                                                                                         rdfs:label "CVV"@en ,
                                                                                                    "Card Verification Value" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/ActOfBorrowing
cco:ActOfBorrowing rdf:type owl:Class ;
                   rdfs:subClassOf cco:ActOfPossession ;
                   cco:definition "Act of gaining possession by promising to return something, or something similar." ;
                   rdfs:label "Act of Borrowing" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/ActOfLending
cco:ActOfLending rdf:type owl:Class ;
                 rdfs:subClassOf cco:ActOfPossession ;
                 cco:definition "Act of ceasing to possess something by transferring possession to another Agent base on promise of return of same or like thing." ;
                 rdfs:label "Act of Lending" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/ActOfSelling
cco:ActOfSelling rdf:type owl:Class ;
                 rdfs:subClassOf cco:IntentionalAct ;
                 cco:definition "Planned Act of exchanging something for Financial Value" ;
                 rdfs:label "Act of Selling" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/AddressIdentifier
cco:AddressIdentifier rdf:type owl:Class ;
                      rdfs:subClassOf cco:CodeIdentifier ;
                      rdfs:label "Address ID" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/AgeMeasurement
cco:AgeMeasurement rdf:type owl:Class ;
                   rdfs:subClassOf cco:TemporalIntervalIdentifier ;
                   cco:definition "A Measurement of a temporal interval that a History of a thing occurs on." ;
                   rdfs:label "Age Measurement" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/ArtifactDesignContentEntity
cco:ArtifactDesignContentEntity rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/AutomobileModel
cco:AutomobileModel rdf:type owl:Class ;
                    rdfs:subClassOf cco:ArtifactDesignContentEntity ;
                    cco:definition "An Artifact Design that prescribes the general features, platform, available options, and desired functionality of one or more generations or years of a range of motor vehicles produced by a specific manufacturer." ;
                    rdfs:label "Automobile Model" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/AutomobileTrimLevel
cco:AutomobileTrimLevel rdf:type owl:Class ;
                        rdfs:subClassOf cco:ArtifactDesignContentEntity ;
                        cco:definition "An Artifact Design that prescribes the general features, platform, available options, and desired functionality of one or more generations or years of a range of motor vehicles produced by a specific manufacturer." ;
                        rdfs:label "Automobile Trim Level" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/AutomotiveModelGeneration
cco:AutomotiveModelGeneration rdf:type owl:Class ;
                              rdfs:subClassOf cco:ArtifactDesignContentEntity ;
                              cco:definition "An Artifact Design that prescribes the specific features, trim options, components, and desired functionality of a range of motor vehicles within the context of a specific model produced by a manufacturer." ;
                              rdfs:label "Automotive Model Generation" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/BankAccount
cco:BankAccount rdf:type owl:Class ;
                rdfs:subClassOf cco:FinancialArtifactFunction ;
                cco:definition "Financial Artifact Function for storing, saving, and transfering Financial Value." ;
                rdfs:label "Bank Account" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/BankBranch
cco:BankBranch rdf:type owl:Class ;
               rdfs:subClassOf cco:FinancialInstitution ;
               cco:definition "A subordinate office of (and at a distance from) a Financial Institution to better serve local customers." ;
               rdfs:label "Bank Branch" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Blog
cco:Blog rdf:type owl:Class ;
         rdfs:subClassOf cco:InformationBearingArtifact ;
         cco:definition "An Information Bearing Artifacts for short articles from the same person or organization." ;
         rdfs:label "Blog" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Brand
cco:Brand rdf:type owl:Class ;
          rdfs:subClassOf cco:DesignativeName ;
          cco:definition "Designative Name of entity intended to evoke  recognition and a positive impression from target audience." ;
          rdfs:label "Brand" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/CheckingAccount
cco:CheckingAccount rdf:type owl:Class ;
                    rdfs:subClassOf cco:BankAccount ;
                    cco:definition "A Bank Account for storing Financial Value so checks can be written again its value." ;
                    rdfs:label "Checking Account" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/CodeIdentifier
cco:CodeIdentifier rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Credit
cco:Credit rdf:type owl:Class ;
           rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
           cco:definition "A realizable entity of the capability to borrow Financial Value." ;
           rdfs:label "Credit" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/CreditCard
cco:CreditCard rdf:type owl:Class ;
               rdfs:subClassOf cco:FinancialArtifactFunction ;
               cco:definition "Financial Service Artifact for purchasing on short-term credit." ;
               rdfs:label "Credit Card" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/CreditLimit
cco:CreditLimit rdf:type owl:Class ;
                rdfs:subClassOf cco:Credit ;
                cco:definition "Credit that has specific Financial Value that cannot be exceeded." ;
                rdfs:label "CreditLimit" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Customer
cco:Customer rdf:type owl:Class ;
             rdfs:subClassOf cco:Agent ;
             cco:definition "Agent capable of performing Act of Purchasing." ;
             rdfs:label "Customer" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/DateIdentifier
cco:DateIdentifier rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/DebitCard
cco:DebitCard rdf:type owl:Class ;
              rdfs:subClassOf cco:BankAccount ;
              cco:definition "A Bank Account for making purchases using current Financial Value via a process similar to a Credit Card." ;
              rdfs:label "DebitCard" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/DesignativeInformationContentEntity
cco:DesignativeInformationContentEntity rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/EmailAddress
cco:EmailAddress rdf:type owl:Class ;
                 rdfs:subClassOf cco:TelecommunicationNetworkIdentifier ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cco:designates ;
                                   owl:someValuesFrom cco:EmailBox
                                 ] ;
                 cco:definition "A Telecommunication Network Identifier that uniquely identifies an Email Box, is used to direct Email Messages to the designated Email Box, and consists of a local name part followed by '@' followed by a domain name part."@en ;
                 rdfs:label "Email Address"@en .


###  http://www.ontologyrepository.com/CommonCoreOntologies/EmailBox
cco:EmailBox rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/FacsimileMachine
cco:FacsimileMachine rdf:type owl:Class ;
                     rdfs:subClassOf cco:TelecommunicationInstrument ;
                     cco:alternative_label "Fax"@en ;
                     cco:definition "A Telecommunication Instrument that is designed to send and receive copies of Information Content Entities scanned from printed Documents and Images over a Telephone Network."@en ;
                     cco:definition_source "http://en.wikipedia.org/wiki/Facsimile_machine"^^xsd:anyURI ;
                     rdfs:label "Facsimile Machine"@en .


###  http://www.ontologyrepository.com/CommonCoreOntologies/FacsimileMachineNumber
cco:FacsimileMachineNumber rdf:type owl:Class ;
                           rdfs:subClassOf cco:TelephoneNumber ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cco:designates ;
                                             owl:someValuesFrom cco:TelecommunicationEndpoint
                                           ] ;
                           cco:definition "A Telephone Number, which when called, will automatically receive a facsimile."@en ;
                           rdfs:label "Facsimile Machine Number"@en .


###  http://www.ontologyrepository.com/CommonCoreOntologies/FinancialInstitution
cco:FinancialInstitution rdf:type owl:Class ;
                         rdfs:subClassOf cco:Organization ;
                         cco:definition "Organization that provides financial products and services to Persons or other organizations" ;
                         rdfs:label "Financial Institution" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/GeopoliticalEntity
cco:GeopoliticalEntity rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/InformationBearingEntity
cco:InformationBearingEntity rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/IssuerRole
cco:IssuerRole rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
               cco:definition "Agent or Group of Agents that creates and provides a credential to another agent." ;
               rdfs:label "IssuerRole" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Landlord
cco:Landlord rdf:type owl:Class ;
             rdfs:subClassOf cco:Agent ;
             cco:definition "Agent capable of Act of Renting" ;
             rdfs:label "Landlord" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/License
cco:License rdf:type owl:Class ;
            rdfs:subClassOf cco:ActionPermission ;
            cco:definition "Action Permission granted to a specific Agent or Group of Agents" ;
            rdfs:label "License" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/LocatorName
cco:LocatorName rdf:type owl:Class ;
                rdfs:subClassOf cco:DesignativeName ;
                cco:definition "A Designative Name assigned to a location such as a building, park, or intersection." ;
                rdfs:label "Locator Name" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Logo
cco:Logo rdf:type owl:Class ;
         rdfs:subClassOf cco:Image ;
         cco:definition "An image associated with a thing designed to be recognized and to invoke a positive impression." ;
         rdfs:label "Logo" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/MoneyMarketAccount
cco:MoneyMarketAccount rdf:type owl:Class ;
                       rdfs:subClassOf cco:BankAccount ;
                       cco:definition "A Bank Account for saving and growing Financial Value." ;
                       rdfs:label "Money Market Account" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Pager
cco:Pager rdf:type owl:Class ;
          rdfs:subClassOf cco:TelecommunicationInstrument ;
          cco:definition "Telecommunications Instrument that receives short messages." ;
          rdfs:label "Pager" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Person
cco:Person rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/PostOfficeBox
cco:PostOfficeBox rdf:type owl:Class ;
                  rdfs:subClassOf cco:PostOffice ;
                  cco:definition "A small storage location in a Post Office for Persons to retrieve mail." ;
                  rdfs:label "Post Office Box" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/PostOfficeBoxNumber
cco:PostOfficeBoxNumber rdf:type owl:Class ;
                        rdfs:subClassOf cco:CodeIdentifier ;
                        cco:definition "A Code Identifier for a specific Post Office Box unique to a Post Office." ;
                        rdfs:label "Post Office Box Number" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/PostalAddress
cco:PostalAddress rdf:type owl:Class ;
                  rdfs:subClassOf cco:NonNameIdentifier ;
                  cco:definition "A non-name identifier comprising all that is needed for a Post Office to delivery mail, for example, Name of intended recipient, department, room, and desk number within an organization, building number, street number, street, Postal Zone, city, state, country, Postal Code, and Post Office Box Number." ;
                  rdfs:label "PostalAddress" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/PostalCode
cco:PostalCode rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( cco:CodeIdentifier
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty cco:designates ;
                                                            owl:someValuesFrom cco:PostalZone
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf cco:CodeIdentifier ;
               cco:definition "A Code Identifier that designates some Postal Zone."@en ;
               rdfs:label "Postal Code"@en .


###  http://www.ontologyrepository.com/CommonCoreOntologies/PostalZone
cco:PostalZone rdf:type owl:Class ;
               rdfs:subClassOf cco:GeopoliticalEntity ;
               cco:definition "A Local Administrative Region that delimits a set of delivery points within a postal system of some government."@en ;
               rdfs:label "Postal Zone"@en .


###  http://www.ontologyrepository.com/CommonCoreOntologies/ProperName
cco:ProperName rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/SavingsAccount
cco:SavingsAccount rdf:type owl:Class ;
                   rdfs:subClassOf cco:BankAccount ;
                   cco:definition "A Bank Account for storing and growing Financial Value." ;
                   rdfs:label "Savings Account" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/SponsorRole
cco:SponsorRole rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                cco:definition "A Role that inheres in an Agent or Group of Agents who support a thing through resources, endorsement, association, guidance, etc." ;
                rdfs:label "Sponsor Role" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Stasis
cco:Stasis rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/StasisOfTelecommunicationEndpointAssignment
cco:StasisOfTelecommunicationEndpointAssignment rdf:type owl:Class ;
                                                rdfs:subClassOf cco:Stasis ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/RO_0000057> ;
                                                                  owl:someValuesFrom cco:TelecommunicationEndpoint
                                                                ] ;
                                                cco:definition "A Stasis wherein a Telecommunication Endpoint is assigned to a telecommunication instrument."@en ;
                                                rdfs:label "Stasis of Telecommunication Endpoint Assignment"@en .


###  http://www.ontologyrepository.com/CommonCoreOntologies/SupplierRole
cco:SupplierRole rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                 cco:definition "A Role that inheres in an Agent or Group of Agents who perform ActofSelling" ;
                 rdfs:label "SupplierRole" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Tax
cco:Tax rdf:type owl:Class ;
        rdfs:subClassOf cco:FinancialValue ;
        cco:definition "A Financial Value charged by a Government." ;
        rdfs:label "TAX" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/TelecommunicationEndpoint
cco:TelecommunicationEndpoint rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/TelecommunicationInstrument
cco:TelecommunicationInstrument rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/TelecommunicationNetworkIdentifier
cco:TelecommunicationNetworkIdentifier rdf:type owl:Class ;
                                       rdfs:subClassOf cco:DesignativeInformationContentEntity ;
                                       cco:definition "A Designative Information Content Entity that uniquely identifies a Telecommunication Network or some set of information inhering in such a network, often for the purpose of exchanging information with the identified entity."@en ;
                                       rdfs:label "Telecommunication Network Identifier"@en .


###  http://www.ontologyrepository.com/CommonCoreOntologies/TelephoneNumber
cco:TelephoneNumber rdf:type owl:Class ;
                    rdfs:subClassOf cco:TelecommunicationNetworkIdentifier ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cco:designates ;
                                      owl:someValuesFrom cco:TelecommunicationEndpoint
                                    ] ;
                    cco:definition "A Telecommunication Network Identifier that uniquely identifies a Telecommunication Endpoint, which is typically assigned to a Telephone, as prescribed by a Telephone Account."@en ;
                    rdfs:label "Telephone Number"@en .


###  http://www.ontologyrepository.com/CommonCoreOntologies/ThumbnailImage
cco:ThumbnailImage rdf:type owl:Class ;
                   rdfs:subClassOf cco:Image ;
                   cco:definition "An Image of the same basic content but with less detail." ;
                   rdfs:label "Thumbnail Image" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/ValueAddedTax
cco:ValueAddedTax rdf:type owl:Class ;
                  rdfs:subClassOf cco:Tax ;
                  cco:definition "A Tax added to price of a thing (less prior similar taxes charged on inputs)." ;
                  rdfs:label "VAT" ,
                             "Value Added Tax" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/VehicleIdentificationNumber
cco:VehicleIdentificationNumber rdf:type owl:Class ;
                                rdfs:subClassOf cco:DesignativeInformationContentEntity ;
                                cco:definition "A Designative Information Content Entity that desigantes a motor or towed vehicle within the context of the International Organization for Standardization 3779 and 3780." ;
                                rdfs:label "Vehicle Identification Number" .


###  http://www.ontologyrepository.com/CommonCoreOntologies/VerifiableCredential
cco:VerifiableCredential rdf:type owl:Class ;
                         rdfs:subClassOf cco:Certificate ;
                         cco:definition "A digital certificate that can be verfied without contacting the issuing source." ;
                         rdfs:label "Verifiable Credential" .


