@prefix : <http://mee.foundation/ontologies/ncbitaxon-subset#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://mee.foundation/ontologies/ncbitaxon-subset> .

<http://mee.foundation/ontologies/ncbitaxon-subset> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/ncbitaxon-subset/1.0.0> ;
    dc:date "2026-08-29"^^xsd:date ;
    owl:versionInfo "Version 1.0.0 - initial hand-curated subset of NCBI Taxonomy covering common pet species."@en ;
    rdfs:label "NCBI Taxonomy Common Pet Species Subset"@en ;
    rdfs:comment """A hand-curated subset of NCBI Taxonomy (NCBITaxon, https://www.ncbi.nlm.nih.gov/taxonomy,
                    OBO Foundry PURL http://purl.obolibrary.org/obo/ncbitaxon.owl). This is NOT a full mirror
                    of upstream NCBITaxon — unlike this project's other project_files/ vendor files
                    (PersonOntology.ttl etc., which are complete local mirrors of their upstream CCO domain
                    ontologies), NCBITaxon's full distribution contains approximately 2.7 million classes (all
                    of life), dwarfing even DrOn's ~300MB "too large to vendor" case (project_files/dron-upper.ttl).
                    This file instead declares only the handful of common-pet-species classes actually
                    referenced by other/pets.ttl's pets:hasSpecies design, each declared with its real
                    upstream IRI, rdfs:label, and definition (verified directly against the live NCBITaxon
                    ontology via OLS4, 2026-08-29), and each cited back to its real NCBITaxon class IRI
                    rather than a locally-minted equivalent — this file adds no new identifiers of its own,
                    only re-declares existing external ones for local offline use. Deliberately omits the
                    rdfs:subClassOf chain up through the taxonomic tree (that chain is NCBITaxon's concern,
                    not something this file re-asserts). NCBITaxon content is CC0/public domain (a work of
                    the US National Institutes of Health), so no attribution obligation applies."""@en .

obo:NCBITaxon_9685 rdf:type owl:Class ;
    rdfs:label "Felis catus"@en ;
    rdfs:comment "NCBITaxon 9685. The domestic cat. Common name: cat, domestic cat."@en .

obo:NCBITaxon_9615 rdf:type owl:Class ;
    rdfs:label "Canis lupus familiaris"@en ;
    rdfs:comment "NCBITaxon 9615. The domestic dog. Common name: dog."@en .

obo:NCBITaxon_7957 rdf:type owl:Class ;
    rdfs:label "Carassius auratus"@en ;
    rdfs:comment "NCBITaxon 7957. Common name: goldfish."@en .

obo:NCBITaxon_158456 rdf:type owl:Class ;
    rdfs:label "Betta splendens"@en ;
    rdfs:comment "NCBITaxon 158456. Common name: Siamese fighting fish, betta."@en .

obo:NCBITaxon_9986 rdf:type owl:Class ;
    rdfs:label "Oryctolagus cuniculus"@en ;
    rdfs:comment "NCBITaxon 9986. The domestic rabbit. Common name: rabbit."@en .

obo:NCBITaxon_13146 rdf:type owl:Class ;
    rdfs:label "Melopsittacus undulatus"@en ;
    rdfs:comment "NCBITaxon 13146. Common name: budgerigar, parakeet."@en .
