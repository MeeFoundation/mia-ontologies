#  Common pet birds
#################################################################

obo:NCBITaxon_13146 rdf:type owl:Class ;
    rdfs:label "Melopsittacus undulatus"@en ;
    rdfs:comment "NCBITaxon 13146. Common name: budgerigar, parakeet."@en .

obo:NCBITaxon_13180 rdf:type owl:Class ;
    rdfs:label "Nymphicus hollandicus"@en ;
    rdfs:comment "NCBITaxon 13180. Common name: cockatiel."@en .

obo:NCBITaxon_9135 rdf:type owl:Class ;
    rdfs:label "Serinus canaria"@en ;
    rdfs:comment "NCBITaxon 9135. Common name: canary, Atlantic canary, common canary."@en .

obo:NCBITaxon_60468 rdf:type owl:Class ;
    rdfs:label "Agapornis roseicollis"@en ;
    rdfs:comment "NCBITaxon 60468. Common name: rosy-faced lovebird, peach-faced lovebird."@en .

obo:NCBITaxon_57247 rdf:type owl:Class ;
    rdfs:label "Psittacus erithacus"@en ;
    rdfs:comment "NCBITaxon 57247. Common name: African grey parrot, grey parrot."@en .

obo:NCBITaxon_59729 rdf:type owl:Class ;
    rdfs:label "Taeniopygia guttata"@en ;
    rdfs:comment "NCBITaxon 59729. Common name: zebra finch. Also the NCBITaxon species VBO's 'Zebra finch breed' (obo:VBO_0400039) subclasses."@en .

