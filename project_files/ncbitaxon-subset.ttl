@prefix : <http://mee.foundation/ontologies/ncbitaxon-subset#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://mee.foundation/ontologies/ncbitaxon-subset> .

<http://mee.foundation/ontologies/ncbitaxon-subset> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/ncbitaxon-subset/1.1.0> ;
    dc:date "2026-08-29"^^xsd:date ;
    owl:versionInfo "Version 1.1.0 - expanded from 6 to 33 common pet species (birds, reptiles/amphibians, small mammals, aquarium fish), each verified via OLS4; 5 of the additions are also the exact NCBITaxon species each corresponding VBO breed-group node in project_files/vbo-subset.ttl subclasses (guinea pig, golden hamster, zebrafish, zebra finch, Japanese rice fish)."@en ;
    rdfs:label "NCBI Taxonomy Common Pet Species Subset"@en ;
    rdfs:comment """A hand-curated subset of NCBI Taxonomy (NCBITaxon, https://www.ncbi.nlm.nih.gov/taxonomy,
                    OBO Foundry PURL http://purl.obolibrary.org/obo/ncbitaxon.owl). This is NOT a full mirror
                    of upstream NCBITaxon — unlike this project's other project_files/ vendor files
                    (PersonOntology.ttl etc., which are complete local mirrors of their upstream CCO domain
                    ontologies), NCBITaxon's full distribution contains approximately 2.7 million classes (all
                    of life), dwarfing even DrOn's ~300MB "too large to vendor" case (project_files/dron-upper.ttl)
                    — unlike project_files/vbo-subset.ttl, whose real full size (~20MB, ~19,961 classes) turned
                    out small enough to extract in full for its own pet-relevant scope, NCBITaxon's true scale
                    rules that out entirely, so this file stays a hand-picked list. Covers common companion
                    pets across mammals, birds, reptiles/amphibians, and aquarium fish, each declared with its
                    real upstream IRI, rdfs:label, and definition (verified directly against the live NCBITaxon
                    ontology via OLS4, 2026-08-29), and each cited back to its real NCBITaxon class IRI rather
                    than a locally-minted equivalent — this file adds no new identifiers of its own, only
                    re-declares existing external ones for local offline use. Deliberately omits the
                    rdfs:subClassOf chain up through the taxonomic tree (that chain is NCBITaxon's concern,
                    not something this file re-asserts) — a flat species list is all pets:hasSpecies needs,
                    unlike project_files/vbo-subset.ttl's breed tree. NCBITaxon content is CC0/public domain (a
                    work of the US National Institutes of Health), so no attribution obligation applies."""@en .

#################################################################
#  Common companion mammals
#################################################################

obo:NCBITaxon_9685 rdf:type owl:Class ;
    rdfs:label "Felis catus"@en ;
    rdfs:comment "NCBITaxon 9685. The domestic cat. Common name: cat, domestic cat."@en .

obo:NCBITaxon_9615 rdf:type owl:Class ;
    rdfs:label "Canis lupus familiaris"@en ;
    rdfs:comment "NCBITaxon 9615. The domestic dog. Common name: dog."@en .

obo:NCBITaxon_9986 rdf:type owl:Class ;
    rdfs:label "Oryctolagus cuniculus"@en ;
    rdfs:comment "NCBITaxon 9986. The domestic rabbit. Common name: rabbit."@en .

obo:NCBITaxon_10141 rdf:type owl:Class ;
    rdfs:label "Cavia porcellus"@en ;
    rdfs:comment "NCBITaxon 10141. Common name: guinea pig, domestic guinea pig. Also the NCBITaxon species VBO's 'Guinea pig breed' (obo:VBO_0400026) subclasses."@en .

obo:NCBITaxon_10036 rdf:type owl:Class ;
    rdfs:label "Mesocricetus auratus"@en ;
    rdfs:comment "NCBITaxon 10036. Common name: golden hamster, Syrian hamster. Also the NCBITaxon species VBO's 'Golden hamster breed' (obo:VBO_0400040) subclasses."@en .

obo:NCBITaxon_10047 rdf:type owl:Class ;
    rdfs:label "Meriones unguiculatus"@en ;
    rdfs:comment "NCBITaxon 10047. Common name: Mongolian gerbil, Mongolian jird."@en .

obo:NCBITaxon_34839 rdf:type owl:Class ;
    rdfs:label "Chinchilla lanigera"@en ;
    rdfs:comment "NCBITaxon 34839. Common name: long-tailed chinchilla, chinchilla."@en .

obo:NCBITaxon_9669 rdf:type owl:Class ;
    rdfs:label "Mustela putorius furo"@en ;
    rdfs:comment "NCBITaxon 9669. Common name: domestic ferret, ferret."@en .

obo:NCBITaxon_9368 rdf:type owl:Class ;
    rdfs:label "Atelerix albiventris"@en ;
    rdfs:comment "NCBITaxon 9368. Common name: African pygmy hedgehog, four-toed hedgehog."@en .

obo:NCBITaxon_10116 rdf:type owl:Class ;
    rdfs:label "Rattus norvegicus"@en ;
    rdfs:comment "NCBITaxon 10116. Common name: Norway rat, brown rat, fancy rat (domesticated/pet lineage)."@en .

obo:NCBITaxon_10090 rdf:type owl:Class ;
    rdfs:label "Mus musculus"@en ;
    rdfs:comment "NCBITaxon 10090. Common name: house mouse, fancy mouse (domesticated/pet lineage)."@en .

