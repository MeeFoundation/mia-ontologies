@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix ctpl: <http://mee.foundation/ontologies/cell-templates#> .
@prefix pshapes: <http://mee.foundation/ontologies/persona/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/cell-templates> .

<http://mee.foundation/ontologies/cell-templates> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/cell-templates/1.13.0> ;
    dc:date "2026-08-27"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/cell> ;
    owl:versionInfo "Version 1.13.0 - renamed MedicalAppointmentInfoTemplateCell to MedicalAppointmentTemplateCell, following cat:MedicalAppointmentInfo's rename to cat:MedicalAppointment."@en ;
    rdfs:label "Cell Templates"@en ;
    rdfs:comment """Class-level cell:Cell templates for cat:Category subclasses (category.ttl). Each individual here is what a cat:Category subclass's cat:templateCell value (asserted in category.ttl) points directly at — what the app clones into a new cell when a folder representing that class is first instantiated into a user's tree (Lazy Instantiation). Each is typed solely cell:TCell — cell:TCell and cell:ACell are disjoint (cell.ttl), so a template cell is reusable class-level content, never itself an instantiated member of any relationship. Each also carries cell:templateShape to the SHACL shape(s), in the paired cell-templates-shacl.ttl, describing the content expected of a topic file filed under that category."""@en .

#################################################################
#  cat:Passport
#################################################################

ctpl:PassportTemplateCell rdf:type cell:Cell, cell:TCell ;
    rdfs:label "Passport Template Cell"@en ;
    cell:templateShape pshapes:PassportDocumentShape .

#################################################################
#  cat:BirthCertificate
#################################################################

ctpl:BirthCertificateTemplateCell rdf:type cell:Cell, cell:TCell ;
    rdfs:label "Birth Certificate Template Cell"@en ;
    cell:templateShape pshapes:BirthCertificateDocumentShape .

#################################################################
#  cat:DriversLicense
#################################################################

ctpl:DriversLicenseTemplateCell rdf:type cell:Cell, cell:TCell ;
    rdfs:label "Drivers License Template Cell"@en ;
    cell:templateShape pshapes:DriversLicenseDocumentShape .

#################################################################
#  cat:MedicalAppointment
#################################################################

ctpl:MedicalAppointmentTemplateCell rdf:type cell:Cell, cell:TCell ;
    rdfs:label "Medical Appointment Template Cell"@en ;
    cell:templateShape pshapes:MedicalAppointmentRecordShape .

#################################################################
#  cat:PetsMedications
#################################################################

ctpl:PetMedicationsTemplateCell rdf:type cell:Cell, cell:TCell ;
    rdfs:label "Pet Medications Template Cell"@en ;
    cell:templateShape pshapes:PetMedicationRecordShape .
