@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix ctpl: <http://mee.foundation/ontologies/cell-templates#> .
@prefix cat: <http://mee.foundation/ontologies/category#> .
@prefix pshapes: <http://mee.foundation/ontologies/persona/shapes#> .
@prefix petshapes: <http://mee.foundation/ontologies/pets/shapes#> .
@prefix vehicleshapes: <http://mee.foundation/ontologies/vehicles/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/cell-templates> .

<http://mee.foundation/ontologies/cell-templates> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/cell-templates/2.0.0> ;
    dc:date "2026-09-01"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/cell> ;
    owl:versionInfo "Version 2.0.0 - added cell:category linking each template cell to its category concept (category.ttl), replacing category.ttl's removed cat:templateCell annotation property."@en ;
    rdfs:label "Cell Templates"@en ;
    rdfs:comment """Class-level cell:Cell templates for category concepts (category.ttl's cat:CategoryScheme). Each individual here is what the app clones into a new cell when a folder representing its own cell:category concept is first instantiated into a user's tree (Lazy Instantiation) — finding the template for a given category is a reverse lookup (?tc cell:category cat:X), since category.ttl carries no forward pointer of its own. Each is typed solely cell:TemplateCell — cell:TemplateCell and cell:MemberCell are disjoint (cell.ttl), so a template cell is reusable class-level content, never itself an instantiated member of any relationship. Each also carries cell:templateShape to the SHACL shape(s) — in the paired cell-templates-shacl.ttl for a persona:PersonaTemplate-typed template, or in other/pets-shacl.ttl for a pets:-typed one — describing the content expected of a topic file filed under that category, and cell:isTopicCell (required, exactly one value) — true on ctpl:MedicalAppointmentTemplateCell, ctpl:PetMedicationsTemplateCell, ctpl:PetProfileTemplateCell, and ctpl:VehicleProfileTemplateCell, the templates whose real cells always end up carrying a cell:topic value, false on the other three, flagging whether Lazy Instantiation's clone is expected to be typed cell:TopicCell."""@en .

#################################################################
#  cat:Passport
#################################################################

ctpl:PassportTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Passport Template Cell"@en ;
    cell:category cat:Passport ;
    cell:templateShape pshapes:PassportDocumentShape ;
    cell:isTopicCell false .

#################################################################
#  cat:BirthCertificate
#################################################################

ctpl:BirthCertificateTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Birth Certificate Template Cell"@en ;
    cell:category cat:BirthCertificate ;
    cell:templateShape pshapes:BirthCertificateDocumentShape ;
    cell:isTopicCell false .

#################################################################
#  cat:DriversLicense
#################################################################

ctpl:DriversLicenseTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Drivers License Template Cell"@en ;
    cell:category cat:DriversLicense ;
    cell:templateShape pshapes:DriversLicenseDocumentShape ;
    cell:isTopicCell false .

#################################################################
#  cat:MedicalAppointment
#################################################################

ctpl:MedicalAppointmentTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Medical Appointment Template Cell"@en ;
    cell:category cat:MedicalAppointment ;
    cell:templateShape pshapes:MedicalAppointmentRecordShape ;
    cell:isTopicCell true .

#################################################################
#  cat:PetsMedical
#################################################################

ctpl:PetMedicationsTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Pet Medications Template Cell"@en ;
    cell:category cat:PetsMedical ;
    cell:templateShape petshapes:PetMedicationRecordShape ;
    cell:isTopicCell true .

#################################################################
#  cat:Pets
#################################################################

ctpl:PetProfileTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Pet Profile Template Cell"@en ;
    cell:category cat:Pets ;
    cell:templateShape petshapes:PetShape ;
    cell:isTopicCell true .

#################################################################
#  cat:Vehicles
#################################################################

ctpl:VehicleProfileTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Vehicle Profile Template Cell"@en ;
    cell:category cat:Vehicles ;
    cell:templateShape vehicleshapes:VehicleShape ;
    cell:isTopicCell true .
