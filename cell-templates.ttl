@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix ctpl: <http://mee.foundation/ontologies/cell-templates#> .
@prefix cat: <http://mee.foundation/ontologies/category#> .
@prefix pshapes: <http://mee.foundation/ontologies/persona/shapes#> .
@prefix petshapes: <http://mee.foundation/ontologies/pets/shapes#> .
@prefix vehicleshapes: <http://mee.foundation/ontologies/vehicles/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/cell-templates> .

<http://mee.foundation/ontologies/cell-templates> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/cell-templates/2.11.0> ;
    dc:date "2026-09-04"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/cell> ;
    owl:versionInfo "Version 2.11.0 - added ctpl:TripsTemplateCell (cat:Trips), isTopicCell true, cell:topicGraphShape pshapes:ItineraryShape — a specific trip, backed by the new persona:Itinerary template label (no existing CCO/domain class to multi-type alongside)."@en ;
    rdfs:label "Cell Templates"@en ;
    rdfs:comment """Class-level cell:Cell templates for category concepts (category.ttl's cat:CategoryScheme). Each individual here is what the app clones into a new cell when a folder representing its own cell:category concept is first instantiated into a user's tree (Lazy Instantiation) — finding the template for a given category is a reverse lookup (?tc cell:category cat:X), since category.ttl carries no forward pointer of its own. Each is typed solely cell:TemplateCell — cell:TemplateCell and cell:MemberCell are disjoint (cell.ttl), so a template cell carries no member composition of its own, just the SHACL shape(s) it points to. Three patterns: (1) cell:memberGraphShape carries each template's own document shape, for the three templates whose content is filed as a cell:member graph (Passport, BirthCertificate, DriversLicense; in cell-templates-shacl.ttl); (2) cell:topicGraphShape carries the category's own record shape, for the five whose content is filed as a cell:topic graph instead (MedicalAppointment, PetMedications, PetProfile, VehicleProfile, Companies; in cell-templates-shacl.ttl/other/pets-shacl.ttl/other/vehicles-shacl.ttl) — and those same five also carry cell:memberGraphShape pshapes:JSContactCardPersonShape, so their otherwise-bare cell:member stub graph(s) are expected to also present a minimal JSContactCard-style business-card view of that member (targeting persona:Person directly, per shacl/jscontactcard-shacl.ttl — see cell.ttl's own cell:memberGraphShape comment); (3) cell:memberGraphShape carries pshapes:JSContactCardPersonShape alone, with no cell:topicGraphShape at all, for ctpl:PeopleTemplateCell (cat:People) and its four direct skos:broader children — ctpl:ImmediateFamilyTemplateCell (cat:ImmediateFamily), ctpl:ExtendedFamilyTemplateCell (cat:ExtendedFamily), ctpl:InLawsStepFamilyTemplateCell (cat:InLawsStepFamily), ctpl:OthersTemplateCell (cat:Others) — each a purely organizational category with no document type and no topic content of its own, whose only real expectation is that its member(s) present that same minimal business-card view. Also carries cell:isTopicCell (required, exactly one value) — true on the five templates in pattern (2), whose real cells always end up carrying a cell:topic value, false on the other eight (patterns (1) and (3)), flagging whether Lazy Instantiation's clone is expected to be typed cell:TopicCell."""@en .

#################################################################
#  cat:Passport
#################################################################

ctpl:PassportTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Passport Template Cell"@en ;
    cell:category cat:Passport ;
    cell:memberGraphShape pshapes:JSContactCardPersonShape ;
    cell:topicGraphShape pshapes:PassportDocumentShape ;
    cell:isTopicCell true .

