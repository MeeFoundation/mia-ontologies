@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix topic: <http://mee.foundation/ontologies/topic#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix g: <http://mee.foundation/ontologies/group#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/cell> .

<http://mee.foundation/ontologies/cell> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/cell/3.14.0> ;
    dc:date "2026-08-02"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/topic> ;
    owl:versionInfo "Version 3.14.0 - split cell:topics into cell:partyTopics (the required per-party baseline, one or more per party in the relationship) and cell:otherTopics (any number of additional topics beyond that baseline). Cardinality for both is enforced per party count by cell-shacl.ttl's new per-party-class shapes, not uniformly as cell:topics's single sh:minCount 1 was. No change to domain (cell:ACell) or range (topic:SCTopicGraph)."@en ;
    rdfs:label "Cell Ontology"@en ;
    rdfs:comment """Cell Ontology for the Mee Identity Agent. Defines cell:Cell — the self-contained content facet of a cell — independent of where any cat:Category (see category.ttl) chooses to place it in a navigational tree. cell:Cell splits further into two orthogonal sub-facets: cell:TCell (template) and cell:ACell (actual/instantiated), which a single cell individual may carry either or both of."""@en .


#################################################################
#    Annotation Properties for Cell DataBook Classification
#################################################################

cell:abstract rdf:type owl:AnnotationProperty ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:boolean ;
    rdfs:label "abstract"@en ;
    rdfs:comment "True if this class is not directly instantiated in DataBooks — it exists only to organize the class hierarchy."@en .

cell:label rdf:type owl:AnnotationProperty ;
    rdfs:domain cell:Cell ;
    rdfs:range xsd:string ;
    rdfs:label "label"@en ;
    rdfs:comment "Default display name for a concrete cell:Cell subtype (e.g. \"Two-Party Cell\"), asserted directly on the class rather than an instance. Distinct from category.ttl's cat:label, which is the user-editable per-instance display name of an associated cat:Category — cell.ttl cannot reference cat:label since category.ttl imports cell.ttl, not the reverse."@en .


#################################################################
#    Cell
#
#    A cell:Cell instance is a self-contained content record —
#    independent of any tree position in a category tree. A cell:Cell
#    is pointed at by a cat:Node's cat:cell property; a cell has no
#    way to discover its own node(s) other than by reverse lookup on
#    the category side. The relationship is many-to-one, not 1:1: one
#    or more cell:Cell individuals may share the same cat:Node, each
#    an independent piece of content at that one tree position.
#
#    cell:Cell itself carries only what's common to every cell
#    regardless of facet: file-system bookkeeping (cell:note,
#    cell:folder). Everything facet-specific — including
#    cell:subject (the resource(s) the cell is about) and
#    cell:partyTopics/cell:otherTopics (its linked topic:SCTopicGraph
#    container(s)) — lives on cell:TCell or cell:ACell below.
#################################################################

cell:Cell rdf:type owl:Class ;
    cell:abstract true ;
    rdfs:label "Cell"@en ;
    rdfs:comment "Superclass of every cell individual, carrying only what's common regardless of facet: file-system bookkeeping (cell:note, cell:folder). Formerly named cell:Parties as a class (the tree-position class, before cell.ttl's 3.0.0 split moved that name to category.ttl's cat:Category). A cell:Cell carries no tree position of its own and no link to one — it is instead pointed at by a cat:Node's cat:cell property (see category.ttl); attaching or moving a cell in any tree only ever touches that node's own cat:cell, never anything on the cell itself, which is what keeps a cell robust under PDN sync. Party composition (cell:parties, cell:OneParty/cell:MultiParty), creator metadata (cell:creator), identity/topic links (cell:subject, cell:partyTopics, cell:otherTopics), and validation (cell:shape) now live on the cell:ACell facet, not directly here — see cell.ttl 3.7.0/3.10.0/3.12.0/3.14.0."@en .


#################################################################
#    Cell Facets: Template (TCell) and Actual (ACell)
#
#    A cell:Cell splits into two orthogonal facets, mirroring
#    category.ttl's Category/Node split:
#
#    cell:TCell — the template facet. Carries cell:templateShape,
#    reachable from a cat:Category subclass via cat:templateCell
#    (category.ttl). Describes what a topic filed under that
#    category is expected to look like once instantiated.
#
#    cell:ACell — the actual/instantiated facet. Carries cell:parties
#    (and, by extension, cell:OneParty/cell:MultiParty), cell:creator,
#    cell:subject (required, one or two resource IRIs identifying who
#    or what the cell is about), cell:partyTopics (required, one or
#    more linked topic:SCTopicGraph containers per party in the
#    relationship — cardinality varies by party count) and
#    cell:otherTopics (any number of additional topic:SCTopicGraph
#    containers beyond that baseline), and cell:shape — the
#    sh:NodeShape(s) validating this specific cell's own content
#    directly, as opposed to content a future topic filed under a
#    template category should conform to.
#
#    A cell individual may carry either facet alone, or both at once:
#    every individual in cell-templates.ttl is both a reusable
#    template (cell:TCell, carrying cell:templateShape) and a real
#    piece of party-classified content (cell:OneParty, a cell:ACell
#    subclass, carrying cell:parties) — it is simply multi-typed with
#    both.
#################################################################

cell:TCell rdf:type owl:Class ;
    cell:abstract true ;
    rdfs:subClassOf cell:Cell ;
    rdfs:label "Template Cell"@en ;
    rdfs:comment "The template facet of a cell:Cell. A cell:TCell individual is reachable from a cat:Category subclass via that class's cat:templateCell value (category.ttl) — it's what Mia clones into a new cell when a category of that class is first instantiated into a user's tree (Lazy Instantiation). Carries cell:templateShape, linking to the sh:NodeShape(s) describing the content a topic filed under that category is expected to conform to. Most cell:TCell individuals carry no cell:templateShape value — that's the default, not an omission. Formerly, template cells were plainly typed cell:Cell and cell:templateShape had domain cell:Cell; both moved here in cell.ttl 3.7.0."@en .

cell:templateShape rdf:type owl:ObjectProperty ;
    rdfs:domain cell:TCell ;
    rdfs:range sh:NodeShape ;
    rdfs:label "templateShape"@en ;
    rdfs:comment "Links a cell:TCell individual (one reached via a cat:Category subclass's cat:templateCell, category.ttl) directly to the sh:NodeShape(s) that describe the content a topic file filed under that category is expected to conform to — e.g. ctpl:PassportTemplateCell (cell-templates.ttl) carries pshapes:PassportDocumentShape (cell-templates-shacl.ttl). Makes the shape reachable by RDF traversal alone (cat:Category -> cat:templateCell -> cell:templateShape -> sh:NodeShape), not merely by file co-location or naming convention. A template cell with no known shape (most of them) carries no cell:templateShape value. Distinct from cell:shape (cell:ACell), which validates an actual cell's own content directly rather than describing what a future topic filed under a template category should look like — though when Lazy Instantiation clones this TCell into a new ACell, this value is exactly what gets copied into that clone's cell:shape. Formerly cat:templateShape (category.ttl), then domain cell:Cell (cell.ttl 3.6.0); narrowed to cell:TCell in cell.ttl 3.7.0 once the template facet was split out."@en .

cell:ACell rdf:type owl:Class ;
    cell:abstract true ;
    rdfs:subClassOf cell:Cell ;
    rdfs:label "Actual Cell"@en ;
    rdfs:comment "The actual/instantiated facet of a cell:Cell — real, party-classified content, as opposed to reusable template content (cell:TCell). Carries cell:parties (and is further specialized by party count into cell:OneParty and cell:MultiParty — see Cell Party Composition below), cell:creator, cell:subject (required, one or two resource IRIs — e.g. a p:Person/g:Group/o:Organization — identifying who or what the cell's relationship is about), cell:partyTopics (required, one or more topic:SCTopicGraph containers backing the cell's content — one per party in the relationship, cardinality enforced per party count), cell:otherTopics (any number of additional topic:SCTopicGraph containers beyond that baseline), and cell:shape. Every concrete party-count class (cell:OneParty, cell:TwoParty, cell:ThreePlusParty) is a subclass of cell:ACell, not cell:Cell directly, as of cell.ttl 3.7.0 — so an ordinary instantiated cell is typed through its party class alone, and only a cell that is also a template (see cell-templates.ttl) needs cell:TCell added explicitly. A cell is not typed cell:ACell at all until it has real content (cell:parties set) — a pure tree-position placeholder with nothing filed under it yet stays a bare cell:Cell, and is therefore exempt from requiring cell:subject/cell:partyTopics."@en .

cell:shape rdf:type owl:ObjectProperty ;
    rdfs:domain cell:ACell ;
    rdfs:range sh:NodeShape ;
    rdfs:label "shape"@en ;
    rdfs:comment "Links an actual (non-template) cell:ACell individual directly to the sh:NodeShape(s) validating that specific cell's own content — its own linked topic data — rather than describing what a topic filed under some other, template category should look like (that's cell:templateShape, on cell:TCell). Populated by copy-on-clone: when Lazy Instantiation clones a cat:Category subclass's cell:TCell (via cat:templateCell) into a new cell:ACell for a user's tree, whatever cell:templateShape value the TCell carried is copied into the new ACell's cell:shape — the same validation expectation, now attached to the concrete instance rather than the abstract template, so content later filed under that instantiated cell can actually be validated. Optional; most cells carry no cell:shape value, since most template cells carry no cell:templateShape value to copy in the first place."@en .

cell:creator rdf:type owl:ObjectProperty ;
    rdfs:domain cell:ACell ;
    rdfs:range [ rdf:type owl:Class ; owl:unionOf ( p:Person g:Group o:Organization ) ] ;
    rdfs:label "creator"@en ;
    rdfs:comment "Identifies who created a cell's content — a named individual of p:Person, g:Group, or o:Organization. At most one value. Mirrors the union-range pattern used by topic:claimant (topic.ttl), referencing those classes by name without owl:imports. Domain narrowed from cell:Cell to cell:ACell in cell.ttl 3.7.0, since only actual/instantiated cells have a creator."@en .

cell:parties rdf:type owl:ObjectProperty ;
    rdfs:domain cell:ACell ;
    rdfs:range cell:ACell ;
    rdfs:label "parties"@en ;
    rdfs:comment "Links a cell:ACell individual to the concrete cell:ACell subclass it instantiates: cell:OneParty, cell:TwoParty, or cell:ThreePlusParty. Value is the class itself (e.g. cell:OneParty), not a string — mirroring cat:category's (category.ttl) use of class-value punning as an object property's range. Exactly one value required, matching that individual's own rdf:type. Formerly named cell:num-parties; domain and range narrowed from cell:Cell to cell:ACell in cell.ttl 3.7.0, since only actual/instantiated cells carry party composition."@en .


#################################################################
#    Cell Party Composition
#
#    An actual (cell:ACell) cell varies by how many total parties
#    (the user plus zero or more others) are involved in the
#    relationship it represents: cell:OneParty (the user alone), or
#    cell:MultiParty (the user plus one or more others, further split
#    into cell:TwoParty and cell:ThreePlusParty). Both are subclasses
#    of cell:ACell, not cell:Cell directly, as of cell.ttl 3.7.0.
#################################################################

cell:MultiParty rdf:type owl:Class ;
    cell:abstract true ;
    rdfs:subClassOf cell:ACell ;
    rdfs:label "MultiParty"@en ;
    rdfs:comment "Abstract superclass of the two cell types involving more than one total party: cell:TwoParty (exactly one other party) and cell:ThreePlusParty (two or more other parties, e.g. a group). Subclass of cell:ACell (moved from cell:Cell directly in cell.ttl 3.7.0)."@en .

cell:TwoParty rdf:type owl:Class ;
    rdfs:subClassOf cell:MultiParty ;
    rdfs:label "TwoParty"@en ;
    cell:label "Two-Party Cell" ;
    rdfs:comment "A cell representing a 1:1 relationship with a specific person, organization, or other party."@en .

cell:ThreePlusParty rdf:type owl:Class ;
    rdfs:subClassOf cell:MultiParty ;
    rdfs:label "ThreePlusParty"@en ;
    cell:label "Multi-Party Cell" ;
    rdfs:comment "A cell representing a shared relationship with two or more other parties — e.g. a group of people or organizations. Not to be confused with g:Group (a PDN group node)."@en .

cell:OneParty rdf:type owl:Class ;
    rdfs:subClassOf cell:ACell ;
    rdfs:label "OneParty"@en ;
    cell:label "Cell" ;
    rdfs:comment "A cell with no external party — plain content with no connection or group semantics. Subclass of cell:ACell (moved from cell:Cell directly in cell.ttl 3.7.0)."@en .


#################################################################
#    Cell Subject and Topic Links
#
#    cell:subject has domain cell:ACell and is an
#    owl:AnnotationProperty (not an ObjectProperty — see its own
#    comment below); cell:partyTopics and cell:otherTopics both have
#    domain cell:ACell and are owl:ObjectProperty. A cell not yet
#    typed cell:ACell (no real content filed under it yet) carries
#    none of the three.
#
#    cell:partyTopics and cell:otherTopics split what was a single
#    cell:topics property (cell.ttl up to 3.13.0) in two: partyTopics
#    is the required baseline — at least one topic:SCTopicGraph per
#    party in the relationship (cardinality enforced per party count
#    by cell-shacl.ttl's per-party-class shapes, not expressible as a
#    single OWL cardinality restriction here); otherTopics is any
#    number of additional topics beyond that baseline, uniformly
#    optional and unbounded regardless of party count.
#################################################################

cell:subject rdf:type owl:AnnotationProperty ;
    rdfs:domain cell:ACell ;
    rdfs:range xsd:anyURI ;
    rdfs:label "subject"@en ;
    rdfs:comment "Identifies the underlying resource(s) — typically a p:Person, g:Group, or o:Organization, e.g. :Bob_Johnson or :Self — that an actual (instantiated) cell's relationship is about. One value for a cell whose content centers on a single party (e.g. :Self alone on a cell:OneParty cell, or the shared group/organization entity alone on a cell:ThreePlusParty cell); up to two for a cell:TwoParty cell (:Self and the other party). Required: one or two values (1..2), enforced per party count by cell-shacl.ttl's per-party-class shapes via sh:nodeKind sh:IRI/sh:minCount/sh:maxCount (not expressed as an OWL cardinality restriction here, matching this ontology's existing convention for cell:parties). Distinct from cell:partyTopics/cell:otherTopics, which link to the actual topic:SCTopicGraph DataBook container(s) backing the cell's content — cell:subject identifies *who or what*, cell:partyTopics/cell:otherTopics identify *which topic files*. Renamed from cell:primary (cell.ttl up to 3.11.0), which was an owl:ObjectProperty pointing directly at a single required topic:SCTopicGraph container. Converted here to an owl:AnnotationProperty with range xsd:anyURI — an owl:ObjectProperty cannot have a datatype range — mirroring topic:subject's identical owl:AnnotationProperty/xsd:anyURI pattern (topic.ttl 1.13.0)."@en .

cell:partyTopics rdf:type owl:ObjectProperty ;
    rdfs:domain cell:ACell ;
    rdfs:range topic:SCTopicGraph ;
    rdfs:label "partyTopics"@en ;
    rdfs:comment "Links an actual (instantiated) cell to its required baseline of Subject-Claimant classified topic DataBooks (topic:SCTopicGraph, which has no subclasses — see topic.ttl 1.9.0) — at least one per party in the relationship. Cardinality is enforced per party count by cell-shacl.ttl's per-party-class shapes: exactly 1 for cell:OneParty; 2..4 for cell:TwoParty (matching the four self-vs-other combinations — self-by-self, other-by-self, other-by-other, self-by-other); 3..N for cell:ThreePlusParty (at least one per member, no upper bound). Split from cell:topics (cell.ttl up to 3.13.0), which required only a blanket 'at least one, no upper bound' regardless of party count — cell:partyTopics is the part of that old guarantee that scales with party count; see cell:otherTopics for the part that doesn't. Which of the four self-vs-other cases a given value represents comes from that topic's own subject/claimant combination, not from which property linked it or from a distinct rdf:type."@en .

cell:otherTopics rdf:type owl:ObjectProperty ;
    rdfs:domain cell:ACell ;
    rdfs:range topic:SCTopicGraph ;
    rdfs:label "otherTopics"@en ;
    rdfs:comment "Links an actual (instantiated) cell to any number of additional Subject-Claimant classified topic DataBooks (topic:SCTopicGraph) beyond the required cell:partyTopics baseline — e.g. extra notes, historical topics, or supplementary claims not tied to a specific self-vs-other combination. Optional, unbounded (0..N), uniformly across all party counts — enforced by cell-shacl.ttl's :ACellShape (sh:class topic:SCTopicGraph only, no sh:minCount). Split from cell:topics (cell.ttl up to 3.13.0); see cell:partyTopics for the part of that old property's guarantee that scales with party count instead."@en .


#################################################################
#    Cell Notes and Folders
#
#    Every cell is associated with two separate but parallel
#    folder hierarchies that mirror its cat:Node's position in
#    the user's tree and are kept in sync by the Mia application:
#
#    Notes hierarchy — one folder per cell plus one .md file
#    per cell, rooted at a configurable notes root (e.g.
#    ~/MiaNotes/). Folder names and nesting match the category tree
#    exactly. The note for a cell is stored as X.md inside the
#    X folder (e.g. Family/Family.md) — the same name as the folder
#    itself. This matches the Obsidian Folder Notes plugin
#    convention, which treats a file named exactly after its
#    containing folder as the note for that folder.
#
#    Traditional PKM tools have no built-in way to associate a note
#    with a folder itself. Mia's same-name convention solves this:
#    the cell note is co-located with its folder and directly
#    compatible with PKM folder-note tools such as Obsidian (Folder
#    Notes plugin), Logseq, or Foam.
#
#    Files hierarchy — one folder per cell, rooted at a
#    configurable files root (e.g. ~/MiaFiles/). Folder names and
#    nesting match the category tree exactly. Each folder may
#    contain arbitrary files and additional subfolders that are not
#    part of the category tree itself.
#
#    When a cat:Node is created, renamed, or deleted, Mia updates
#    both hierarchies automatically for every cell it references via
#    cat:cell. The two roots are stored separately so the notes
#    hierarchy can be opened as a standalone PKM vault without
#    exposing the files hierarchy.
#
#    Redundancy and robustness: in the normal case cell:note and
#    cell:folder are technically redundant — both paths can be
#    derived from the associated cat:Node's tree position plus the
#    two configured roots. They are retained for three reasons:
#
#    1. Divergence detection: if a stored path no longer matches
#       the derived path, Mia knows the user has manually renamed
#       or rearranged folders outside of Mia and can alert them or
#       attempt reconciliation rather than failing silently.
#
#    2. Graceful degradation: Mia can continue to locate a
#       cell's folder or note via the stored path even when
#       the folder hierarchy has drifted out of sync with the
#       category tree.
#
#    3. Intentional overrides: a user may deliberately want a
#       cell's folder to live somewhere other than the derived
#       location (e.g. ~/Photos/Family/ rather than the default
#       ~/MiaFiles/People/Family/). The explicit link records that
#       intentional deviation without disrupting the category tree.
#################################################################

cell:note rdf:type owl:AnnotationProperty ;
    rdfs:domain cell:Cell ;
    rdfs:range xsd:anyURI ;
    rdfs:label "note"@en ;
    rdfs:comment "Relative path within the notes hierarchy root to the cell note file, stored as CellName.md inside the cell folder (e.g. family/Family.md) — matching the Obsidian Folder Notes plugin convention. Normally derived automatically by Mia from the associated cat:Category's tree position; retained explicitly for divergence detection, graceful degradation, and intentional overrides."@en .

cell:folder rdf:type owl:AnnotationProperty ;
    rdfs:domain cell:Cell ;
    rdfs:range xsd:anyURI ;
    rdfs:label "folder"@en ;
    rdfs:comment "Relative path within the files hierarchy root to the folder for this cell. Normally derived automatically by Mia from the associated cat:Category's tree position; retained explicitly for divergence detection, graceful degradation, and intentional overrides."@en .
