@prefix g: <http://mee.foundation/ontologies/graph#> .
@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix agent: <http://mee.foundation/ontologies/agent#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/graph> .

<http://mee.foundation/ontologies/graph> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/graph/1.19.0> ;
    dc:date "2026-08-30"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/cell> ;
    rdfs:label "Graph Ontology"@en ;
    rdfs:comment """Graph Ontology for the Cellula App"""@en .


#################################################################
#    Annotation Properties for Graph DataBook Classification
#################################################################

g:claimant rdf:type owl:AnnotationProperty ;
    rdfs:label "claimed by"@en ;
    rdfs:comment """Annotates a graph DataBook with the identity making the claim —
                    a named individual of p:Person, o:Organization, or agent:Agent
                    (e.g. :Self, a p:Person or o:Organization instance; or an invited
                    agent:Agent, self-claiming its own cell:members entry and claiming
                    whatever cell:topic content it contributes — see agent.ttl). Applied
                    to the graph DataBook's own IRI (its plain `id`) — the same IRI
                    cell:members/cell:topic link to from the cell side —
                    not to the `#graph`-suffixed `graph.named_graph` IRI, and not
                    to the Person/Organization/Agent individual."""@en ;
    rdfs:domain g:SCGraph ;
    rdfs:range [ rdf:type owl:Class ; owl:unionOf ( p:Person o:Organization agent:Agent ) ] .

g:subject rdf:type owl:AnnotationProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment """Annotates a graph DataBook with the resource it is about. Value
                    may be any resource IRI — a graph need not be about a person's
                    identity. In the example data, every subject value happens to be a
                    named individual of p:Person or o:Organization (e.g.
                    :Self, a p:Person or o:Organization instance), but that is
                    a convention of the example data, not an ontology requirement.
                    Applied to the graph DataBook's own IRI (its plain `id`) — the same
                    IRI cell:members/cell:topic link to from the cell
                    side — not to the `#graph`-suffixed `graph.named_graph` IRI,
                    and not to the subject resource itself."""@en ;
    rdfs:domain g:SCGraph ;
    rdfs:range xsd:anyURI .

g:template rdf:type owl:AnnotationProperty ;
    rdfs:label "template"@en ;
    rdfs:comment """Annotates a graph DataBook with the persona template type that applies to it.
                    Value is one of the persona:PersonaTemplate subclasses (persona:BirthCertificateDocument,
                    persona:JSContactCard, persona:DriversLicenseDocument, persona:PassportDocument,
                    persona:MedicalAppointmentRecord).
                    Used to select the appropriate per-template SHACL shapes file for validation.
                    Applied to the graph DataBook's own IRI (its plain `id`), not the
                    `#graph`-suffixed `graph.named_graph` IRI — matching g:subject and
                    g:claimant."""@en ;
    rdfs:domain g:Graph ;
    rdfs:range <http://mee.foundation/ontologies/persona#PersonaTemplate> .


#################################################################
#    Graph (DataBook) and SCGraph
#################################################################

g:Graph rdf:type owl:Class ;
    cell:abstract true ;
    rdfs:label "Graph"@en ;
    rdfs:comment "A graph DataBook — a named graph of claims about some resource, filed in a specific relationship or situation, extracted into a named graph (graph.named_graph, the DataBook's own `id` plus a `#graph` fragment) — since this class's instances represent exactly the content that becomes that named graph, see the '#### Graph' DataBook section heading convention. The resource it is about need not be a person's identity — see g:subject. Instances of this class and its annotations (g:subject, g:claimant, g:template) are typed and asserted on the DataBook's own `id` IRI, not the `#graph`-suffixed named graph IRI that wraps its extracted content."@en .

g:SCGraph rdf:type owl:Class ;
    rdfs:subClassOf g:Graph ;
    rdfs:label "SCGraph"@en ;
    rdfs:comment "Subject-Claimant graph: the concrete class every self-vs-other classified graph DataBook is typed as directly — it has no subclasses; the four self-vs-other cases (self-by-self, other-by-self, other-by-other, self-by-other) are determined directly from the combination of subject and claimant. Carries the subject and claimant annotations — every graph reachable from a cell, via cell:members/cell:topic, is a g:SCGraph and so always carries them."@en .
