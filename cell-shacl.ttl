@prefix : <http://mee.foundation/ontologies/cell/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix agent: <http://mee.foundation/ontologies/agent#> .
@prefix cat: <http://mee.foundation/ontologies/category#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/cell/shapes> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/cell/shapes/3.31.0> ;
    dc:date "2026-09-03"^^xsd:date ;
    rdfs:label "Cell Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for cell:Cell DataBook instances (the content facet of a cell) and cell:SCGraph DataBook instances (the graph DataBooks a cell links to) in the Cell Ontology."@en .


#################################################################
#  Cell
#  cell:Cell carries only what's common to every cell regardless of
#  kind: category. A cell's folder is purely the filesystem folder its
#  cell-databook physically lives in, never a stored path, so there's
#  nothing to constrain here for that. Graph links (cell:member/
#  cell:topic) live on :MemberCellShape/:TopicCellShape below — since
#  cell:TemplateCell and cell:MemberCell are disjoint (cell.ttl), those
#  shapes fire only on the MemberCell branch, not on template cells.
#################################################################

:CellShape
    a sh:NodeShape ;
    sh:targetClass cell:Cell ;
    sh:message "Cell validation."@en ;

    # cell:category — at most one value (0..1), on any cell:Cell
    # regardless of kind. Absent exactly when the cell is of the
    # UserDefined category — identified precisely by its
    # cell-databook's filename carrying the literal "(custom)"
    # disambiguator, not a vague "no canonical counterpart" judgment
    # call; SHACL can't see filenames, so this specific absence/filename
    # pairing is checked in CLAUDE.md's Check 20/10j, not here. Now
    # constrained via sh:class skos:Concept — category.ttl's tree is a
    # SKOS concept scheme, not an OWL class hierarchy, so a legal value
    # really is rdf:type skos:Concept, no class-value punning involved
    # (contrast vehicles:hasVehicleType, other/vehicles.ttl, which still
    # does pun a real class hierarchy). The nested skos:inScheme check
    # narrows this to only this app's own category concepts — sh:class
    # skos:Concept alone would accept any SKOS concept from anywhere.
    sh:property [
        sh:path cell:category ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:property [
            sh:path skos:inScheme ;
            sh:hasValue cat:CategoryScheme ;
            sh:message "A cell:category value must be a concept in cat:CategoryScheme (category.ttl)."@en
        ] ;
        sh:message "A cell may have at most one cell:category value: the category concept its content is filed under, if any."@en
    ] ;

    # rdf:type — exactly one of cell:TemplateCell/cell:MemberCell, never
    # both and never neither, mirroring cell.ttl's owl:disjointWith
    # cell:TemplateCell cell:MemberCell. A reusable class-level template
    # (cell-templates.ttl) is typed cell:TemplateCell only; every cell
    # in a user's own tree is typed cell:MemberCell only — there is no
    # legal bare tree-position-only cell with no member content in the
    # MemberCell branch (a category node with nothing substantive to
    # say still carries a minimal stub cell:member entry, see
    # CLAUDE.md's Check 21) and no cell legally carries both kinds at
    # once.
    sh:xone (
        [ sh:property [ sh:path rdf:type ; sh:hasValue cell:TemplateCell ] ]
        [ sh:property [ sh:path rdf:type ; sh:hasValue cell:MemberCell ] ]
    ) .


#################################################################
#  TemplateCell
#  cell:TemplateCell is the template facet of a cell — reusable content,
#  identified by its own cell:category value naming the category concept
#  (a skos:Concept in cat:CategoryScheme, category.ttl) it's a template
#  for — a reverse lookup, since category.ttl carries no forward pointer.
#################################################################

:TemplateCellShape
    a sh:NodeShape ;
    sh:targetClass cell:TemplateCell ;
    sh:message "Template Cell validation."@en ;

    # cell:templateShape — at most one value. Not constrained to sh:class
    # sh:NodeShape here: the individuals it points at (e.g.
    # pshapes:PassportDocumentShape) are only typed sh:NodeShape in
    # cell-templates-shacl.ttl, which is deliberately excluded from Tier 1's
    # merged-data validation (see EXAMPLE.md's Validation section) — asserting
    # sh:class here would spuriously fail against that merged graph. Most
    # template cells carry no cell:templateShape value at all — that's the
    # default.
    sh:property [
        sh:path cell:templateShape ;
        sh:maxCount 1 ;
        sh:message "A cell:TemplateCell may have at most one cell:templateShape value."@en
    ] ;

    # cell:isTopicCell — required, exactly one value, must be a boolean.
    # Every cell:TemplateCell individual must declare it explicitly, one
    # way or the other.
    sh:property [
        sh:path cell:isTopicCell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "A cell:TemplateCell must have exactly one cell:isTopicCell value, and it must be a boolean."@en
    ] .


#################################################################
#  MemberCell
#  cell:MemberCell is the actual/instantiated facet of a cell — real,
#  member-classified content. :MemberCellShape constrains
#  cell:creator/cell:owner/cell:member — cell:owner and cell:member are
#  each required, one or more values, no fixed upper bound (cell:creator
#  stays exactly one); cell:topic's requirement of at least one value, no
#  upper bound (on the cell:TopicCell subclass only) is enforced by
#  :TopicCellShape, not here. Every cell:owner value must also be one of
#  the cell's active cell:member subjects — an invariant not itself
#  SHACL-expressible (it requires dereferencing each linked graph's own
#  subject), so it is checked only by CLAUDE.md's own integrity check
#  (Check 23), not here. There is no subject property on cell:Cell/
#  cell:MemberCell itself to constrain — a cell's own subject is
#  derived from cell:member/cell:topic's linked graphs' own
#  cell:subject values, rather than asserted directly (see cell.ttl's
#  cell:topic comment; :SCGraphShape below constrains that graph-level
#  cell:subject instead). There is likewise no
#  cell:shape to constrain — a MemberCell's validation shape is derived
#  from its own cell:category value (reverse-lookup the cell:TemplateCell
#  with the same cell:category, cell-templates.ttl) rather than stored on
#  the MemberCell itself.
#################################################################

:MemberCellShape
    a sh:NodeShape ;
    sh:targetClass cell:MemberCell ;
    sh:message "Member Cell validation."@en ;

    # cell:creator — exactly one value, required, must be a Person or Organization
    sh:property [
        sh:path cell:creator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class o:Organization ] ) ;
        sh:message "A cell:MemberCell must have exactly one cell:creator, a single p:Person or o:Organization."@en
    ] ;

    # cell:owner — one or more values, required, no fixed upper bound,
    # each must be a Person or Organization (never an agent:Agent — an
    # invited agent can be a cell:member but can never be promoted to
    # owner; see cell.ttl's cell:owner comment).
    sh:property [
        sh:path cell:owner ;
        sh:minCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class o:Organization ] ) ;
        sh:message "A cell:MemberCell must have at least one cell:owner, each a p:Person or o:Organization."@en
    ] ;

    # cell:member — one or more values, required, no fixed upper bound.
    # Member count is never stored as a class — it's simply the number of
    # distinct subjects among a cell's members/topic, counted at read time
    # when needed (a cell is not expected to ever have more than a couple
    # dozen members).
    sh:property [
        sh:path cell:member ;
        sh:minCount 1 ;
        sh:class cell:SCGraph ;
        sh:message "A cell:MemberCell's cell:member is required, at least one value, and each must be a cell:SCGraph."@en
    ] .


#################################################################
#  TopicCell
#  cell:TopicCell is the subclass of cell:MemberCell for a member cell
#  that actually carries at least one cell:topic value (CLAUDE.md's
#  TopicCell integrity check). :TopicCellShape requires cell:topic at
#  least once, no upper bound, applying to every cell:MemberCell
#  regardless of whether it is also a cell:TopicCell.
#################################################################

:TopicCellShape
    a sh:NodeShape ;
    sh:targetClass cell:TopicCell ;
    sh:message "Topic Cell validation."@en ;

    # cell:topic — one or more values, required. A cell is typed
    # cell:TopicCell precisely because it carries at least one
    # cell:topic value (cell.ttl's cell:TopicCell comment), so this
    # shape requires it — one or more additional graphs beyond the
    # required cell:member baseline, no upper bound.
    sh:property [
        sh:path cell:topic ;
        sh:class cell:SCGraph ;
        sh:minCount 1 ;
        sh:message "A cell:TopicCell must have at least one cell:topic value, and each must be a cell:SCGraph."@en
    ] .


#################################################################
#  Graph DataBook (cell:SCGraph)
#  Validates the subject/claimant classification fields on every
#  graph DataBook — a graph DataBook only ever exists to be linked
#  from a cell (via cell:member/cell:topic above), so its shape lives
#  here alongside the cell shapes rather than in a separate file.
#################################################################

:SCGraphShape
    a sh:NodeShape ;
    sh:targetClass cell:SCGraph ;
    sh:message "SCGraph validation: claimant must be exactly one Person, Organization, or Agent; subject must be exactly one IRI."@en ;
    sh:property [
        sh:path cell:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "cell:subject must have exactly one value, and it must be an IRI."@en
    ] ;
    sh:property [
        sh:path cell:claimant ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class o:Organization ] [ sh:class agent:Agent ] ) ;
        sh:message "cell:claimant must have exactly one value, and it must be a p:Person, o:Organization, or agent:Agent."@en
    ] .
