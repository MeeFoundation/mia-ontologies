@prefix : <http://mee.foundation/ontologies/cell/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix topic: <http://mee.foundation/ontologies/topic#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix g: <http://mee.foundation/ontologies/group#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .

<http://mee.foundation/ontologies/cell/shapes> rdf:type owl:Ontology ;
    owl:versionInfo "Version 3.13.0 - removed :CellShape's cell:note constraint (cell:note was removed from cell.ttl 3.15.0, merging the separate notes/files folder hierarchies into one under cell:folder); :CellShape now constrains only cell:folder's cardinality. (3.12.0: split cell:topics's constraint into cell:otherTopics (unbounded, uniform, stays on :ACellShape) and cell:partyTopics (required baseline, now enforced per party count by three new shapes: :OnePartyShape, :TwoPartyShape, :ThreePlusPartyShape, targeting cell:OneParty/cell:TwoParty/cell:ThreePlusParty respectively). Also moved cell:subject's minCount/maxCount off the uniform :ACellShape and onto those same three per-party shapes, tightening it from a blanket 1..2 to exactly 1 for cell:OneParty/cell:ThreePlusParty and 1..2 for cell:TwoParty — :ACellShape now only checks cell:subject's sh:nodeKind sh:IRI uniformly.)"@en ;
    rdfs:label "Cell Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for cell:Cell DataBook instances (the content facet of a cell) in the Cell Ontology."@en .


#################################################################
#  Cell
#  cell:Cell (formerly cell:Parties) carries only what's common to
#  every cell regardless of facet: folder. Identity/topic links
#  (cell:subject/cell:partyTopics/cell:otherTopics) live on
#  :ACellShape and the per-party-count shapes below, since their
#  domain narrowed from cell:Cell to cell:ACell in cell.ttl 3.10.0 —
#  a cell not yet typed cell:ACell has none of them.
#################################################################

:CellShape
    a sh:NodeShape ;
    sh:targetClass cell:Cell ;
    sh:message "Cell validation."@en ;

    # cell:folder — at most one associated folder path
    sh:property [
        sh:path cell:folder ;
        sh:maxCount 1 ;
        sh:message "A cell may have at most one cell:folder value."@en
    ] .


#################################################################
#  TCell
#  cell:TCell is the template facet of a cell (cell.ttl 3.7.0) —
#  reusable content reached via a cat:Category subclass's
#  cat:templateCell (category.ttl).
#################################################################

:TCellShape
    a sh:NodeShape ;
    sh:targetClass cell:TCell ;
    sh:message "Template Cell validation."@en ;

    # cell:templateShape — at most one value. Not constrained to sh:class
    # sh:NodeShape here: the individuals it points at (e.g.
    # pshapes:PassportDocumentShape) are only typed sh:NodeShape in
    # cell-templates-shacl.ttl, which is deliberately excluded from Tier 1's
    # merged-data validation (see README.md's Validation section) — asserting
    # sh:class here would spuriously fail against that merged graph. Most
    # template cells carry no cell:templateShape value at all — that's the
    # default.
    sh:property [
        sh:path cell:templateShape ;
        sh:maxCount 1 ;
        sh:message "A cell:TCell may have at most one cell:templateShape value."@en
    ] .


#################################################################
#  ACell
#  cell:ACell is the actual/instantiated facet of a cell (cell.ttl
#  3.7.0) — real, party-classified content. creator and parties
#  moved here from :CellShape when their domain narrowed from
#  cell:Cell to cell:ACell; subject and topics (renamed from
#  primary/secondary, themselves renamed from graph/sc-context)
#  moved here the same way in cell.ttl 3.10.0/3.12.0. As of cell.ttl
#  3.14.0/cell-shacl.ttl 3.12.0, cell:subject's and cell:topics's
#  per-party-count cardinality is no longer enforced uniformly here —
#  see :OnePartyShape/:TwoPartyShape/:ThreePlusPartyShape below.
#  :ACellShape retains only cell:subject's structural sh:nodeKind
#  check (applies regardless of party count) and cell:otherTopics's
#  unbounded, uniform constraint.
#################################################################

:ACellShape
    a sh:NodeShape ;
    sh:targetClass cell:ACell ;
    sh:message "Actual Cell validation."@en ;

    # cell:subject — each value must be an IRI (not constrained to
    # sh:class topic:SCTopicGraph — its range widened to xsd:anyURI in
    # cell.ttl 3.12.0, since its values are the resource(s) the cell is
    # about, e.g. a p:Person/g:Group/o:Organization, not a topic
    # container). Cardinality (exactly 1 vs 1..2) now varies by party
    # count — see :OnePartyShape/:TwoPartyShape/:ThreePlusPartyShape
    # below, not here.
    sh:property [
        sh:path cell:subject ;
        sh:nodeKind sh:IRI ;
        sh:message "A cell:ACell's cell:subject value(s) must each be an IRI."@en
    ] ;

    # cell:otherTopics — any number of additional topics beyond the
    # required cell:partyTopics baseline, each a topic:SCTopicGraph.
    # Optional and unbounded uniformly across all party counts, unlike
    # cell:partyTopics (see :OnePartyShape/:TwoPartyShape/
    # :ThreePlusPartyShape below). Split from cell:topics (cell.ttl up
    # to 3.13.0).
    sh:property [
        sh:path cell:otherTopics ;
        sh:class topic:SCTopicGraph ;
        sh:message "A cell:ACell's cell:otherTopics values, if present, must each be a topic:SCTopicGraph."@en
    ] ;

    # cell:creator — at most one value, must be a Person, Group, or Organization
    sh:property [
        sh:path cell:creator ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class g:Group ] [ sh:class o:Organization ] ) ;
        sh:message "A cell:ACell's cell:creator, if present, must be a single p:Person, g:Group, or o:Organization."@en
    ] ;

    # cell:parties — exactly one value, must be the class
    # cell:OneParty, cell:TwoParty, or cell:ThreePlusParty itself
    # (class-value punning, not a string). Required: every cell:ACell
    # instance is typed as one of these three by definition.
    sh:property [
        sh:path cell:parties ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( cell:OneParty cell:TwoParty cell:ThreePlusParty ) ;
        sh:message "A cell:ACell's cell:parties is required and must be the class cell:OneParty, cell:TwoParty, or cell:ThreePlusParty."@en
    ] ;

    # cell:shape — at most one value. Not constrained to sh:class sh:NodeShape
    # here, for the same reason as cell:templateShape above: whatever shape
    # graph types the target as sh:NodeShape may not be part of the merged
    # data a given validation run includes. Most actual cells carry no
    # cell:shape value at all — that's the default.
    sh:property [
        sh:path cell:shape ;
        sh:maxCount 1 ;
        sh:message "A cell:ACell may have at most one cell:shape value."@en
    ] .


#################################################################
#  Per-Party-Count Shapes
#  cell:subject and cell:partyTopics both scale with how many total
#  parties a cell:ACell individual represents (cell.ttl's Cell Party
#  Composition). Since yaml-to-rdf.py types every cell:ACell instance
#  with its concrete party class (cell:OneParty/cell:TwoParty/
#  cell:ThreePlusParty) in addition to asserting cell:parties, these
#  three shapes can target those classes directly via sh:targetClass.
#  cell:otherTopics is deliberately absent here — it stays uniform,
#  unbounded, and optional regardless of party count (see :ACellShape
#  above).
#################################################################

:OnePartyShape
    a sh:NodeShape ;
    sh:targetClass cell:OneParty ;
    sh:message "OneParty Cell validation."@en ;

    sh:property [
        sh:path cell:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A cell:OneParty's cell:subject is required, exactly one value."@en
    ] ;

    sh:property [
        sh:path cell:partyTopics ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class topic:SCTopicGraph ;
        sh:message "A cell:OneParty's cell:partyTopics is required, exactly one value, and it must be a topic:SCTopicGraph."@en
    ] .

:TwoPartyShape
    a sh:NodeShape ;
    sh:targetClass cell:TwoParty ;
    sh:message "TwoParty Cell validation."@en ;

    sh:property [
        sh:path cell:subject ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
        sh:message "A cell:TwoParty's cell:subject is required, one or two values."@en
    ] ;

    sh:property [
        sh:path cell:partyTopics ;
        sh:minCount 2 ;
        sh:maxCount 4 ;
        sh:class topic:SCTopicGraph ;
        sh:message "A cell:TwoParty's cell:partyTopics is required, two to four values (one per self-vs-other combination), and each must be a topic:SCTopicGraph."@en
    ] .

:ThreePlusPartyShape
    a sh:NodeShape ;
    sh:targetClass cell:ThreePlusParty ;
    sh:message "ThreePlusParty Cell validation."@en ;

    sh:property [
        sh:path cell:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A cell:ThreePlusParty's cell:subject is required, exactly one value."@en
    ] ;

    sh:property [
        sh:path cell:partyTopics ;
        sh:minCount 3 ;
        sh:class topic:SCTopicGraph ;
        sh:message "A cell:ThreePlusParty's cell:partyTopics is required, at least three values (one per party), and each must be a topic:SCTopicGraph."@en
    ] .
