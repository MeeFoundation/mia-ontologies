@prefix : <http://mee.foundation/ontologies/cell/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix topic: <http://mee.foundation/ontologies/topic#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/cell/shapes> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/cell/shapes/3.23.0> ;
    dc:date "2026-08-24"^^xsd:date ;
    rdfs:label "Cell Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for cell:Cell DataBook instances (the content facet of a cell) in the Cell Ontology."@en .


#################################################################
#  Cell
#  cell:Cell carries only what's common to every cell regardless of
#  facet: origin. A cell's folder is purely the filesystem folder its
#  cell-databook physically lives in, never a stored path, so there's
#  nothing to constrain here for that. Topic links
#  (cell:memberTopics/cell:otherTopics) live on
#  :ACellShape and the per-member-count shapes below — since every
#  cell:Cell is always also typed cell:ACell (no bare tree-position-only
#  cell), those shapes fire on every cell without exception.
#################################################################

:CellShape
    a sh:NodeShape ;
    sh:targetClass cell:Cell ;
    sh:message "Cell validation."@en ;

    # cell:origin — at most one value (0..1), on any cell:Cell
    # regardless of facet. Absent exactly when the cell is of the
    # UserDefined category — identified precisely by its
    # cell-databook's filename carrying the literal "(custom)"
    # disambiguator, not a vague "no canonical counterpart" judgment
    # call; SHACL can't see filenames, so this specific absence/filename
    # pairing is checked in CLAUDE.md's Check 20/10j, not here. Not
    # constrained via sh:class cat:Category: a legal value is the
    # concrete leaf subclass itself (e.g. cat:Others), never rdf:type
    # cat:Category — class-value punning, same reasoning as
    # cell:memberCount's range below.
    sh:property [
        sh:path cell:origin ;
        sh:maxCount 1 ;
        sh:message "A cell may have at most one cell:origin value: the cat:Category subclass its content is filed under, if any."@en
    ] ;

    # rdf:type cell:ACell — required on every cell:Cell individual, no
    # exceptions: there is no legal bare tree-position-only cell with no
    # member content. A category node with nothing substantive to say
    # still carries a minimal stub cell:memberTopics entry (see
    # CLAUDE.md's Check 21) rather than skipping ACell typing altogether.
    sh:property [
        sh:path rdf:type ;
        sh:hasValue cell:ACell ;
        sh:message "Every cell:Cell individual must also be typed cell:ACell — no bare tree-position-only cell with no member content is legal."@en
    ] .


#################################################################
#  TCell
#  cell:TCell is the template facet of a cell — reusable content
#  reached via a cat:Category subclass's cat:templateCell
#  (category.ttl).
#################################################################

:TCellShape
    a sh:NodeShape ;
    sh:targetClass cell:TCell ;
    sh:message "Template Cell validation."@en ;

    # cell:templateShape — at most one value. Not constrained to sh:class
    # sh:NodeShape here: the individuals it points at (e.g.
    # pshapes:PassportDocumentShape) are only typed sh:NodeShape in
    # cell-templates-shacl.ttl, which is deliberately excluded from Tier 1's
    # merged-data validation (see EXAMPLE.md's Validation section) — asserting
    # sh:class here would spuriously fail against that merged graph. Most
    # template cells carry no cell:templateShape value at all — that's the
    # default.
    sh:property [
        sh:path cell:templateShape ;
        sh:maxCount 1 ;
        sh:message "A cell:TCell may have at most one cell:templateShape value."@en
    ] .


#################################################################
#  ACell
#  cell:ACell is the actual/instantiated facet of a cell — real,
#  member-classified content. :ACellShape retains only
#  cell:otherTopics's cap of at most one value (uniform regardless of
#  member count); cell:memberTopics's per-member-count cardinality is
#  enforced by :OneMemberShape/:TwoMemberShape/:ThreePlusMemberShape
#  below, not here. There is no cell:subject to constrain — a cell's
#  subject is derived from cell:memberTopics/cell:otherTopics rather
#  than asserted (see cell.ttl's cell:otherTopics comment).
#################################################################

:ACellShape
    a sh:NodeShape ;
    sh:targetClass cell:ACell ;
    sh:message "Actual Cell validation."@en ;

    # cell:otherTopics — at most one additional topic beyond the
    # required cell:memberTopics baseline, uniformly across all member
    # counts. Capped at one (rather than unbounded) so that, together
    # with cell:memberTopics, a cell's subject can always be derived
    # unambiguously — see cell.ttl's cell:otherTopics comment.
    sh:property [
        sh:path cell:otherTopics ;
        sh:class topic:SCTopicGraph ;
        sh:maxCount 1 ;
        sh:message "A cell:ACell may have at most one cell:otherTopics value, and it must be a topic:SCTopicGraph."@en
    ] ;

    # cell:creator — exactly one value, required, must be a Person or Organization
    sh:property [
        sh:path cell:creator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class o:Organization ] ) ;
        sh:message "A cell:ACell must have exactly one cell:creator, a single p:Person or o:Organization."@en
    ] ;

    # cell:memberCount — exactly one value, must be the class
    # cell:OneMember, cell:TwoMember, or cell:ThreePlusMember itself
    # (class-value punning, not a string). Required: every cell:ACell
    # instance is typed as one of these three by definition.
    sh:property [
        sh:path cell:memberCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( cell:OneMember cell:TwoMember cell:ThreePlusMember ) ;
        sh:message "A cell:ACell's cell:memberCount is required and must be the class cell:OneMember, cell:TwoMember, or cell:ThreePlusMember."@en
    ] ;

    # cell:shape — at most one value. Not constrained to sh:class sh:NodeShape
    # here, for the same reason as cell:templateShape above: whatever shape
    # graph types the target as sh:NodeShape may not be part of the merged
    # data a given validation run includes. Most actual cells carry no
    # cell:shape value at all — that's the default.
    sh:property [
        sh:path cell:shape ;
        sh:maxCount 1 ;
        sh:message "A cell:ACell may have at most one cell:shape value."@en
    ] .


#################################################################
#  Per-Member-Count Shapes
#  cell:memberTopics scales with how many total members a cell:ACell
#  individual represents (cell.ttl's Cell Member Composition). Since
#  yaml-to-rdf.py types every cell:ACell instance with its concrete
#  member class (cell:OneMember/cell:TwoMember/cell:ThreePlusMember)
#  in addition to asserting cell:memberCount, these three shapes can
#  target those classes directly via sh:targetClass. cell:otherTopics
#  is deliberately absent here — it stays uniform, capped at one, and
#  optional regardless of member count (see :ACellShape above).
#################################################################

:OneMemberShape
    a sh:NodeShape ;
    sh:targetClass cell:OneMember ;
    sh:message "OneMember Cell validation."@en ;

    sh:property [
        sh:path cell:memberTopics ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class topic:SCTopicGraph ;
        sh:message "A cell:OneMember's cell:memberTopics is required, exactly one value, and it must be a topic:SCTopicGraph."@en
    ] .

:TwoMemberShape
    a sh:NodeShape ;
    sh:targetClass cell:TwoMember ;
    sh:message "TwoMember Cell validation."@en ;

    sh:property [
        sh:path cell:memberTopics ;
        sh:minCount 2 ;
        sh:maxCount 4 ;
        sh:class topic:SCTopicGraph ;
        sh:message "A cell:TwoMember's cell:memberTopics is required, two to four values (one per self-vs-other combination), and each must be a topic:SCTopicGraph."@en
    ] .

:ThreePlusMemberShape
    a sh:NodeShape ;
    sh:targetClass cell:ThreePlusMember ;
    sh:message "ThreePlusMember Cell validation."@en ;

    sh:property [
        sh:path cell:memberTopics ;
        sh:minCount 3 ;
        sh:class topic:SCTopicGraph ;
        sh:message "A cell:ThreePlusMember's cell:memberTopics is required, at least three values (one per member), and each must be a topic:SCTopicGraph."@en
    ] .
