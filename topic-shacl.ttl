@prefix : <http://mee.foundation/ontologies/topic/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix topic: <http://mee.foundation/ontologies/topic#> .
@prefix persona: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/topic/shapes> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/topic> ;
    owl:versionIRI <http://mee.foundation/ontologies/topic/shapes/1.4.0> ;
    dc:date "2026-08-23"^^xsd:date ;
    rdfs:label "Topic Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for topic.ttl's topic:SCTopicGraph DataBook instances."@en .


#################################################################
#  Topic DataBook (topic:SCTopicGraph)
#  Validates the subject/claimant classification fields on every
#  topic DataBook
#################################################################

:SCTopicGraphShape
    a sh:NodeShape ;
    sh:targetClass topic:SCTopicGraph ;
    sh:message "SCTopicGraph validation: claimant must be exactly one Person or Organization; subject must be exactly one IRI."@en ;
    sh:property [
        sh:path topic:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "topic:subject must have exactly one value, and it must be an IRI."@en
    ] ;
    sh:property [
        sh:path topic:claimant ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class persona:Person ] [ sh:class o:Organization ] ) ;
        sh:message "topic:claimant must have exactly one value, and it must be a persona:Person or o:Organization."@en
    ] .
