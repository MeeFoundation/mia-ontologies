#
#    Government-ID and date designator classes below are superseded by
#    committed cco: ent IRIs (PersonOntology / StagingOntology). Instance
#    and shape usages have been migrated to the cco: terms; the persona:
#    declarations above are retained for continuity and marked deprecated.
#    Safe to remove once Paul confirms no downstream databooks reference them.
#################################################################

persona:DriversLicenseNumber owl:deprecated true ; rdfs:seeAlso cco:ent00000065 .
persona:PassportNumber       owl:deprecated true ; rdfs:seeAlso cco:ent00000066 .
persona:PlaceOfBirth         owl:deprecated true ; rdfs:seeAlso cco:ent00000067 .
persona:IssuingJurisdiction  owl:deprecated true ; rdfs:seeAlso cco:ent00000068 .
persona:IssuingCountry       owl:deprecated true ; rdfs:seeAlso cco:ent00000068 .
persona:IssueDate            owl:deprecated true ; rdfs:seeAlso cco:ent00000069 .
