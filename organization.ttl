@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/organization> .

<http://mee.foundation/ontologies/organization> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/organization/1.3.0> ;
    owl:imports <https://w3id.org/cco-domains/cco/AgentOntology> ;
    dc:date "2026-08-27"^^xsd:date ;
    owl:versionInfo "Version 1.3.0 - updated topic.ttl reference to graph.ttl following that ontology's rename, and renamed 'Mee Identity Agent' to 'Cellula App'."@en ;
    rdfs:label "Organization Ontology"@en ;
    rdfs:comment """Organization Ontology for the Cellula App.
                    Describes organizations that participate in the Personal Data Network.
                    Peer of persona.ttl, graph.ttl, and pdn-identity.ttl."""@en .


#################################################################
#    Organization
#################################################################

o:Organization rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001180 ;  # CCO Organization (Group of Agents)
    rdfs:label "Organization"@en ;
    rdfs:comment """An organization (company, government agency, non-profit, etc.)
                    that participates in the Personal Data Network."""@en .
