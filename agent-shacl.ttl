@prefix : <http://mee.foundation/ontologies/agent/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix agent: <http://mee.foundation/ontologies/agent#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/agent/shapes> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/agent> ;
    owl:versionIRI <http://mee.foundation/ontologies/agent/shapes/1.0.0> ;
    dc:date "2026-08-30"^^xsd:date ;
    rdfs:label "Agent Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for the Agent Ontology."@en .


#################################################################
#  Agent
#################################################################

:AgentShape
    a sh:NodeShape ;
    sh:targetClass agent:Agent ;
    sh:property [
        sh:path agent:actsFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class o:Organization ] ) ;
        sh:message "An agent:Agent must have exactly one agent:actsFor value, a single p:Person or o:Organization."@en
    ] ;
    sh:message "Agent validation."@en .
